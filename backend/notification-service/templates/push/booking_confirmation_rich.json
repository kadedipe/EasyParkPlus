{
  "title": "✅ Booking Confirmed!",
  "body": "Your parking spot is reserved at {{ parking_name }}",
  "subtitle": "Spot {{ spot_number }} | Vehicle: {{ vehicle_plate }}",
  "summary": "{{ start_time|date("%b %d, %I:%M %p") }} - {{ end_time|date("%I:%M %p") }}",
  "image": "{{ image_url }}/parking/{{ parking_id }}/banner.jpg",
  "icon": "{{ image_url }}/icons/booking_confirmed.png",
  "data": {
    "type": "booking_confirmation",
    "booking_id": "{{ booking_id }}",
    "booking_reference": "{{ booking_reference }}",
    "parking_name": "{{ parking_name }}",
    "parking_id": "{{ parking_id }}",
    "parking_address": "{{ parking_address }}",
    "spot_number": "{{ spot_number }}",
    "spot_type": "{{ spot_type }}",
    "vehicle_plate": "{{ vehicle_plate }}",
    "vehicle_model": "{{ vehicle_model }}",
    "start_time": "{{ start_time.isoformat() }}",
    "end_time": "{{ end_time.isoformat() }}",
    "duration": "{{ duration }}",
    "duration_minutes": "{{ duration_minutes }}",
    "amount": "{{ total_amount }}",
    "currency": "{{ currency }}",
    "payment_method": "{{ payment_method }}",
    "transaction_id": "{{ transaction_id }}",
    "qr_data": "{{ qr_data }}",
    "qr_code_url": "{{ app_url }}/qr/{{ booking_id }}",
    "map_url": "{{ map_link }}",
    "directions_url": "{{ directions_link }}",
    "click_action": "OPEN_BOOKING_DETAILS",
    "deep_link": "{{ app_scheme }}://booking/{{ booking_id }}",
    "web_url": "{{ app_url }}/bookings/{{ booking_id }}",
    "share_text": "I've booked parking at {{ parking_name }} on {{ start_time|date('%b %d') }}!",
    "timestamp": "{{ current_time.isoformat() }}",
    "expires_at": "{{ end_time.isoformat() }}",
    "version": "2.0"
  },
  "actions": [
    {
      "id": "view_booking",
      "title": "View Details",
      "icon": "🔍",
      "url": "{{ app_url }}/bookings/{{ booking_id }}",
      "authentication_required": true
    },
    {
      "id": "show_qr",
      "title": "Show QR Code",
      "icon": "📱",
      "url": "{{ app_url }}/bookings/{{ booking_id }}/qr",
      "authentication_required": true
    },
    {
      "id": "get_directions",
      "title": "Get Directions",
      "icon": "🗺️",
      "url": "{{ directions_link }}",
      "authentication_required": false
    },
    {
      "id": "cancel_booking",
      "title": "Cancel",
      "icon": "❌",
      "url": "{{ app_url }}/bookings/{{ booking_id }}/cancel",
      "destructive": true,
      "authentication_required": true
    }
  ],
  "android": {
    "priority": "high",
    "notification": {
      "click_action": "OPEN_BOOKING_DETAILS",
      "sound": "default",
      "vibrate": [200, 100, 200, 100, 200],
      "color": "#059669",
      "icon": "@drawable/ic_notification",
      "large_icon": "@drawable/ic_booking_confirmed",
      "channel_id": "booking_notifications",
      "channel_name": "Booking Confirmations",
      "channel_description": "Notifications for parking booking confirmations",
      "sticky": true,
      "priority": 2,
      "visibility": 1,
      "ticker": "Your parking booking is confirmed!",
      "badge_icon_type": "small",
      "category": "transport",
      "timeout_after": 86400000,
      "local_only": false,
      "default_vibrate_timings": true,
      "default_sound": true,
      "default_light_settings": true,
      "lights": {
        "argb": 0xff059669,
        "on_ms": 500,
        "off_ms": 1000
      },
      "progress": {
        "max": 100,
        "progress": 0,
        "indeterminate": false
      },
      "auto_cancel": false,
      "ongoing": false,
      "only_alert_once": false,
      "when": "{{ start_time.timestamp() }}",
      "uses_chronometer": true,
      "show_when": true,
      "local_only": false,
      "notification_style": "big_picture",
      "big_picture": "{{ image_url }}/parking/{{ parking_id }}/big_picture.jpg",
      "big_text": "Your booking at {{ parking_name }} (Spot {{ spot_number }}) is confirmed. Duration: {{ duration }}. Total: {{ total_amount|currency(currency) }}"
    },
    "data": {
      "priority": "high",
      "content_available": true,
      "mutable_content": true,
      "delay_while_idle": false,
      "time_to_live": 86400
    }
  },
  "apns": {
    "payload": {
      "aps": {
        "alert": {
          "title": "✅ Booking Confirmed!",
          "body": "Your parking at {{ parking_name }} (Spot {{ spot_number }}) is confirmed",
          "subtitle": "{{ start_time|date('%b %d, %I:%M %p') }} - {{ end_time|date('%I:%M %p') }}",
          "action-loc-key": "View Booking",
          "launch-image": "launch_image"
        },
        "sound": {
          "critical": 1,
          "name": "default",
          "volume": 0.8
        },
        "badge": 1,
        "category": "BOOKING_CATEGORY",
        "thread-id": "booking-{{ booking_id }}",
        "mutable-content": 1,
        "content-available": 1,
        "interruption-level": "time-sensitive",
        "relevance-score": 1.0,
        "target-content-id": "booking-{{ booking_id }}",
        "url-args": ["booking", "{{ booking_id }}"]
      },
      "data": {
        "type": "booking_confirmation",
        "booking_id": "{{ booking_id }}",
        "parking_name": "{{ parking_name }}",
        "spot_number": "{{ spot_number }}",
        "start_time": "{{ start_time.isoformat() }}",
        "end_time": "{{ end_time.isoformat() }}"
      },
      "fcm_options": {
        "analytics_label": "booking_confirmation",
        "image": "{{ image_url }}/ios/booking_confirmation.png"
      }
    },
    "headers": {
      "apns-priority": "10",
      "apns-push-type": "alert",
      "apns-topic": "com.parking.app",
      "apns-expiration": "86400"
    }
  },
  "webpush": {
    "notification": {
      "title": "✅ Booking Confirmed!",
      "body": "Your parking at {{ parking_name }} (Spot {{ spot_number }}) is confirmed for {{ start_time|date('%b %d, %I:%M %p') }}",
      "icon": "{{ app_url }}/icons/icon-192.png",
      "badge": "{{ app_url }}/icons/badge-72.png",
      "image": "{{ image_url }}/booking_confirmation_banner.png",
      "vibrate": [200, 100, 200],
      "dir": "auto",
      "lang": "en",
      "renotify": true,
      "requireInteraction": true,
      "tag": "booking-{{ booking_id }}",
      "silent": false,
      "timestamp": "{{ current_time.timestamp() }}",
      "data": {
        "url": "{{ app_url }}/bookings/{{ booking_id }}",
        "icon": "{{ app_url }}/icons/booking-192.png",
        "qr_code": "{{ app_url }}/qr/{{ booking_id }}",
        "map_url": "{{ map_link }}",
        "directions_url": "{{ directions_link }}"
      },
      "actions": [
        {
          "action": "view",
          "title": "📱 View Booking Details",
          "icon": "{{ app_url }}/icons/view-icon.png"
        },
        {
          "action": "qr",
          "title": "🔑 Show QR Code",
          "icon": "{{ app_url }}/icons/qr-icon.png"
        },
        {
          "action": "directions",
          "title": "🗺️ Get Directions",
          "icon": "{{ app_url }}/icons/map-icon.png"
        },
        {
          "action": "extend",
          "title": "⏰ Extend Session",
          "icon": "{{ app_url }}/icons/extend-icon.png"
        },
        {
          "action": "cancel",
          "title": "❌ Cancel Booking",
          "icon": "{{ app_url }}/icons/cancel-icon.png"
        }
      ]
    },
    "fcm_options": {
      "link": "{{ app_url }}/bookings/{{ booking_id }}",
      "analytics_label": "web_booking_confirmation"
    }
  }
}