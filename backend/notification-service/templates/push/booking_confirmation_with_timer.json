{
  "title": "✅ Booking Confirmed!",
  "body": "Your parking at {{ parking_name }} starts in {{ time_until_start }}",
  "subtitle": "Spot {{ spot_number }} | Vehicle: {{ vehicle_plate }}",
  "data": {
    "type": "booking_confirmation",
    "booking_id": "{{ booking_id }}",
    "parking_name": "{{ parking_name }}",
    "spot_number": "{{ spot_number }}",
    "start_time": "{{ start_time.isoformat() }}",
    "end_time": "{{ end_time.isoformat() }}",
    "time_until_start": "{{ time_until_start }}",
    "time_until_end": "{{ time_until_end }}",
    "click_action": "OPEN_BOOKING_DETAILS"
  },
  "android": {
    "priority": "high",
    "notification": {
      "click_action": "OPEN_BOOKING_DETAILS",
      "channel_id": "booking_notifications",
      "uses_chronometer": true,
      "when": "{{ start_time.timestamp() }}",
      "show_when": true
    }
  },
  "apns": {
    "payload": {
      "aps": {
        "alert": {
          "title": "✅ Booking Confirmed!",
          "body": "Your parking at {{ parking_name }} starts in {{ time_until_start }}",
          "subtitle": "Spot {{ spot_number }} | Vehicle: {{ vehicle_plate }}"
        },
        "sound": "default",
        "badge": 1,
        "mutable-content": 1,
        "category": "BOOKING_TIMER"
      },
      "data": {
        "booking_id": "{{ booking_id }}",
        "start_time": "{{ start_time.isoformat() }}"
      }
    }
  },
  "webpush": {
    "notification": {
      "title": "✅ Booking Confirmed!",
      "body": "Your parking at {{ parking_name }} starts in {{ time_until_start }}",
      "icon": "{{ app_url }}/icons/icon-192.png",
      "badge": "{{ app_url }}/icons/badge-72.png",
      "requireInteraction": true,
      "tag": "booking-{{ booking_id }}",
      "data": {
        "url": "{{ app_url }}/bookings/{{ booking_id }}"
      }
    }
  }
}