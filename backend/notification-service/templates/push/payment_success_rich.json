{
  "title": "✅ Payment Confirmed!",
  "body": "Your payment was processed successfully",
  "summary": "{{ amount|currency(currency) }} via {{ payment_method }}",
  "image": "{{ image_url }}/payment/success_banner.jpg",
  "icon": "{{ image_url }}/icons/payment_success.png",
  "data": {
    "type": "payment_success",
    "payment_id": "{{ payment_id }}",
    "transaction_id": "{{ transaction_id }}",
    "transaction_short_id": "{{ transaction_short_id }}",
    "amount": "{{ amount }}",
    "amount_formatted": "{{ amount|currency(currency) }}",
    "currency": "{{ currency }}",
    "payment_method": "{{ payment_method }}",
    "payment_method_details": "{{ payment_method_details }}",
    "payment_method_icon": "{{ payment_method_icon }}",
    "status": "completed",
    "payment_date": "{{ payment_date.isoformat() }}",
    "payment_date_formatted": "{{ payment_date|date('%B %d, %Y at %I:%M %p') }}",
    "authorization_code": "{{ auth_code }}",
    "receipt_url": "{{ receipt_url }}",
    "receipt_pdf_url": "{{ receipt_pdf_url }}",
    "receipt_short_url": "{{ receipt_short_url }}",
    "invoice_url": "{{ invoice_url }}",
    "invoice_number": "{{ invoice_number }}",
    "booking_id": "{{ booking_id }}",
    "parking_name": "{{ parking_name }}",
    "spot_number": "{{ spot_number }}",
    "start_time": "{{ start_time.isoformat() }}",
    "end_time": "{{ end_time.isoformat() }}",
    "duration": "{{ duration }}",
    "wallet_balance": "{{ new_balance }}",
    "rewards_earned": "{{ rewards_points }}",
    "tax_amount": "{{ tax_amount }}",
    "fee_amount": "{{ fee_amount }}",
    "discount_amount": "{{ discount_amount }}",
    "click_action": "OPEN_PAYMENT_RECEIPT",
    "deep_link": "{{ app_scheme }}://payment/{{ payment_id }}",
    "web_url": "{{ app_url }}/payments/{{ payment_id }}",
    "share_text": "I just made a payment of {{ amount|currency(currency) }} with {{ app_name }}!",
    "timestamp": "{{ current_time.isoformat() }}",
    "version": "2.0"
  },
  "actions": [
    {
      "id": "view_receipt",
      "title": "View Receipt",
      "icon": "📄",
      "url": "{{ receipt_short_url }}",
      "authentication_required": true
    },
    {
      "id": "download_pdf",
      "title": "Download PDF",
      "icon": "💾",
      "url": "{{ receipt_pdf_url }}",
      "authentication_required": true
    },
    {
      "id": "share_receipt",
      "title": "Share",
      "icon": "📤",
      "url": "{{ share_url }}",
      "authentication_required": false
    },
    {
      "id": "view_booking",
      "title": "View Booking",
      "icon": "🚗",
      "url": "{{ app_url }}/bookings/{{ booking_id }}",
      "authentication_required": true,
      "conditional": "{{ booking_id is not none }}"
    }
  ],
  "android": {
    "priority": "high",
    "notification": {
      "click_action": "OPEN_PAYMENT_RECEIPT",
      "sound": "default",
      "vibrate": [200, 100, 200, 100, 200],
      "color": "#10B981",
      "icon": "@drawable/ic_payment_success",
      "large_icon": "@drawable/ic_payment_confirmed",
      "channel_id": "payment_notifications",
      "channel_name": "Payment Confirmations",
      "channel_description": "Notifications for payment confirmations",
      "sticky": false,
      "priority": 2,
      "visibility": 1,
      "ticker": "Payment successful: {{ amount|currency(currency) }}",
      "badge_icon_type": "small",
      "category": "payment",
      "timeout_after": 86400000,
      "local_only": false,
      "default_vibrate_timings": true,
      "default_sound": true,
      "default_light_settings": true,
      "lights": {
        "argb": 0xff10B981,
        "on_ms": 500,
        "off_ms": 1000
      },
      "auto_cancel": true,
      "ongoing": false,
      "only_alert_once": false,
      "when": "{{ payment_date.timestamp() }}",
      "show_when": true,
      "notification_style": "big_picture",
      "big_picture": "{{ image_url }}/android/payment_big_picture.jpg",
      "big_text": "Payment of {{ amount|currency(currency) }} successful via {{ payment_method }}\nTransaction: {{ transaction_short_id }}\nDate: {{ payment_date|date('%B %d, %Y') }}\nTime: {{ payment_date|date('%I:%M %p') }}\nReceipt: {{ receipt_short_url }}",
      "inbox": [
        "Amount: {{ amount|currency(currency) }}",
        "Method: {{ payment_method }}",
        "Transaction: {{ transaction_short_id }}",
        "Date: {{ payment_date|date('%B %d, %Y') }}"
      ],
      "progress": {
        "max": 100,
        "progress": 100,
        "indeterminate": false
      }
    },
    "data": {
      "priority": "high",
      "content_available": true,
      "mutable_content": true,
      "delay_while_idle": false,
      "time_to_live": 86400
    }
  },
  "apns": {
    "payload": {
      "aps": {
        "alert": {
          "title": "✅ Payment Confirmed!",
          "body": "{{ amount|currency(currency) }} via {{ payment_method }}",
          "subtitle": "Transaction {{ transaction_short_id }}",
          "action-loc-key": "View Receipt",
          "launch-image": "launch_image"
        },
        "sound": {
          "critical": 1,
          "name": "payment_success.caf",
          "volume": 0.8
        },
        "badge": 1,
        "category": "PAYMENT_RECEIPT_CATEGORY",
        "thread-id": "payment-{{ payment_id }}",
        "mutable-content": 1,
        "content-available": 1,
        "interruption-level": "time-sensitive",
        "relevance-score": 1.0,
        "target-content-id": "payment-{{ payment_id }}",
        "url-args": ["payment", "{{ payment_id }}", "receipt"]
      },
      "data": {
        "type": "payment_success",
        "payment_id": "{{ payment_id }}",
        "amount": "{{ amount }}",
        "currency": "{{ currency }}",
        "payment_method": "{{ payment_method }}",
        "transaction_id": "{{ transaction_short_id }}",
        "receipt_url": "{{ receipt_short_url }}",
        "pdf_url": "{{ receipt_pdf_url }}",
        "booking_id": "{{ booking_id }}"
      },
      "fcm_options": {
        "analytics_label": "payment_success_ios_rich",
        "image": "{{ image_url }}/ios/payment_success_rich.png"
      }
    },
    "headers": {
      "apns-priority": "10",
      "apns-push-type": "alert",
      "apns-topic": "com.parking.app.payments",
      "apns-expiration": "86400",
      "apns-collapse-id": "payment-{{ payment_id }}"
    }
  },
  "webpush": {
    "notification": {
      "title": "✅ Payment Confirmed!",
      "body": "{{ amount|currency(currency) }} via {{ payment_method }}",
      "icon": "{{ app_url }}/icons/icon-192.png",
      "badge": "{{ app_url }}/icons/badge-72.png",
      "image": "{{ image_url }}/payment_success_banner.jpg",
      "vibrate": [200, 100, 200, 100, 200],
      "dir": "auto",
      "lang": "en",
      "renotify": false,
      "requireInteraction": true,
      "tag": "payment-{{ payment_id }}",
      "silent": false,
      "timestamp": "{{ payment_date.timestamp() }}",
      "data": {
        "url": "{{ app_url }}/payments/{{ payment_id }}",
        "receipt_url": "{{ receipt_short_url }}",
        "pdf_url": "{{ receipt_pdf_url }}",
        "invoice_url": "{{ invoice_url }}",
        "icon": "{{ app_url }}/icons/payment-192.png"
      },
      "actions": [
        {
          "action": "view_receipt",
          "title": "📄 View Receipt",
          "icon": "{{ app_url }}/icons/receipt-icon.png"
        },
        {
          "action": "download_pdf",
          "title": "💾 Download PDF Receipt",
          "icon": "{{ app_url }}/icons/download-icon.png"
        },
        {
          "action": "share",
          "title": "📤 Share Receipt",
          "icon": "{{ app_url }}/icons/share-icon.png"
        },
        {
          "action": "view_booking",
          "title": "🚗 View Booking",
          "icon": "{{ app_url }}/icons/car-icon.png"
        },
        {
          "action": "get_invoice",
          "title": "📑 Get Invoice",
          "icon": "{{ app_url }}/icons/invoice-icon.png"
        }
      ]
    },
    "fcm_options": {
      "link": "{{ app_url }}/payments/{{ payment_id }}",
      "analytics_label": "payment_success_web_rich"
    }
  }
}