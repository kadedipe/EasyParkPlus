# ============================================
# Exceptions (Files to keep)
# ============================================
# Keep example and template files
!.env.example
!.env.dist
!requirements*.txt
!requirements*.in
!*.py
!*.pyi
!*.pyx
!*.pxd
!*.c
!*.h
!*.md
!*.rst
!*.txt
!*.yml.example
!*.yaml.example
!*.json.example

# Keep source code
!*.py
!*.pyi
!*.pyx
!*.pxd
!*.c
!*.h
!*.sh
!*.bash

# Keep configuration templates
!config/*.example
!config/*.template
!config/*.dist

# Keep Docker-related files (but not all)
!Dockerfile
!docker-compose.yml
!docker-compose.*.yml
!.dockerignore

# ============================================
# Final Safety Check
# ============================================
# Ensure we don't accidentally include sensitive files
**/*.pem
**/*.key
**/*.crt
**/*.csr
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.kdb
**/secrets/
**/credentials.json
**/service-account.json
**/*.service-account.json
**/oauth-credentials.json
**/firebase-*.json
**/google-*.json
**/aws-*.json
**/gcp-*.json
**/azure-*.json
**/*.secret
**/*.private
**/*.pub
**/*.pgp
**/*.gpg
**/*.asc
**/.env
**/.env.*
!.env.example

