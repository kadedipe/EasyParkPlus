@startuml
' Parking Management System - Sequence Diagrams
' =============================================

title Parking Management System - Key Operations Sequence Diagram

skinparam sequence {
    ArrowColor #2E7D32
    ActorBorderColor #1565C0
    LifeLineBorderColor #424242
    LifeLineBackgroundColor #ECEFF1
    ParticipantBorderColor #37474F
    ParticipantBackgroundColor #FFFFFF
    ParticipantFontName Arial
    ParticipantFontSize 14
    ParticipantFontStyle bold
    ActorFontStyle bold
    BoxFontSize 12
    BoxPadding 10
    BoxMargin 10
    NoteBorderColor #FF9800
    NoteBackgroundColor #FFF3E0
    NoteFontSize 12
    NoteTextAlignment left
}

skinparam {
    shadowing false
    roundcorner 10
    style strictuml
}

' =============================================
' Define Participants
' =============================================

actor "Customer" as Customer
participant "Mobile App" as MobileApp
participant "API Gateway" as APIGateway
participant "Auth Service" as AuthService
participant "Parking Slot Service" as ParkingService
participant "Pricing Service" as PricingService
participant "Payment Service" as PaymentService
participant "Notification Service" as NotificationService
participant "Parking Slot Repository" as SlotRepository
participant "Parking Assignment Repository" as AssignmentRepository
participant "Payment Repository" as PaymentRepository
participant "User Repository" as UserRepository
participant "External Payment Gateway" as PaymentGateway
participant "SMS Gateway" as SMSGateway
participant "Email Service" as EmailService
participant "Parking Sensor" as Sensor
participant "QR Code Generator" as QRGenerator

' =============================================
' Diagram 1: Find Available Parking Slots
' =============================================

box "Find Available Parking Slots" #E8F5E8
Customer -> MobileApp : Search for available slots\n(location, time, vehicle type)
activate MobileApp

MobileApp -> APIGateway : POST /api/v1/parking/slots/search
activate APIGateway

APIGateway -> AuthService : Validate JWT token
activate AuthService
AuthService --> APIGateway : Token validated
deactivate AuthService

APIGateway -> ParkingService : findAvailableSlots(searchCriteria)
activate ParkingService

ParkingService -> SlotRepository : findByLocationAndAvailability(criteria)
activate SlotRepository
SlotRepository --> ParkingService : List<ParkingSlot>
deactivate SlotRepository

ParkingService -> PricingService : calculateRates(slots, duration)
activate PricingService
PricingService --> ParkingService : rates calculated
deactivate PricingService

ParkingService --> APIGateway : List<ParkingSlotDTO>
deactivate ParkingService

APIGateway --> MobileApp : 200 OK with available slots
deactivate APIGateway

MobileApp --> Customer : Display available slots with prices
deactivate MobileApp
end box

' =============================================
' Diagram 2: Book & Assign Parking Slot
' =============================================

box "Book & Assign Parking Slot" #E3F2FD

Customer -> MobileApp : Select slot and book
activate MobileApp

MobileApp -> APIGateway : POST /api/v1/parking/assign
activate APIGateway
note right of APIGateway: Request includes:\n- slotId\n- vehicleId\n- duration\n- paymentMethod
end note

APIGateway -> AuthService : Validate JWT and permissions
activate AuthService
AuthService --> APIGateway : User authenticated
deactivate AuthService

APIGateway -> ParkingService : assignSlot(assignmentRequest)
activate ParkingService

ParkingService -> SlotRepository : findById(slotId) && lockForAssignment()
activate SlotRepository
SlotRepository --> ParkingService : ParkingSlot (locked)
deactivate SlotRepository

ParkingService -> UserRepository : findVehicleById(vehicleId)
activate UserRepository
UserRepository --> ParkingService : Vehicle details
deactivate UserRepository

ParkingService -> PricingService : calculateTotalAmount(slot, vehicle, duration)
activate PricingService
PricingService --> ParkingService : totalAmount
deactivate PricingService

ParkingService -> AssignmentRepository : createAssignment(assignment)
activate AssignmentRepository
AssignmentRepository --> ParkingService : ParkingAssignment created
deactivate AssignmentRepository

ParkingService -> SlotRepository : updateStatus(slotId, OCCUPIED)
activate SlotRepository
SlotRepository --> ParkingService : Status updated
deactivate SlotRepository

ParkingService -> QRGenerator : generateQRCode(assignmentId)
activate QRGenerator
QRGenerator --> ParkingService : QR code image
deactivate QRGenerator

ParkingService --> APIGateway : AssignmentDTO with QR code
deactivate ParkingService

APIGateway --> MobileApp : 201 Created with assignment details
deactivate APIGateway

MobileApp --> Customer : Show confirmation with QR code
deactivate MobileApp

' Async notifications
ParkingService -> NotificationService : sendAssignmentConfirmation(assignment)
activate NotificationService
NotificationService -> EmailService : sendConfirmationEmail(user, assignment)
activate EmailService
EmailService --> NotificationService : Email sent
deactivate EmailService
NotificationService -> SMSGateway : sendConfirmationSMS(user, assignment)
activate SMSGateway
SMSGateway --> NotificationService : SMS sent
deactivate SMSGateway
deactivate NotificationService

end box

' =============================================
' Diagram 3: Process Parking Payment
' =============================================

box "Process Parking Payment" #F3E5F5

Customer -> MobileApp : Confirm payment
activate MobileApp

MobileApp -> APIGateway : POST /api/v1/payments/process
activate APIGateway
note right of APIGateway: Payment request:\n- assignmentId\n- amount\n- paymentMethod\n- cardToken
end note

APIGateway -> AuthService : Validate payment permissions
activate AuthService
AuthService --> APIGateway : Payment authorized
deactivate AuthService

APIGateway -> PaymentService : processPayment(paymentRequest)
activate PaymentService

PaymentService -> AssignmentRepository : findActiveAssignment(assignmentId)
activate AssignmentRepository
AssignmentRepository --> PaymentService : ParkingAssignment
deactivate AssignmentRepository

PaymentService -> PricingService : validateAmount(assignment, requestedAmount)
activate PricingService
PricingService --> PaymentService : Amount valid
deactivate PricingService

PaymentService -> PaymentGateway : chargeCustomer(paymentDetails)
activate PaymentGateway
PaymentGateway --> PaymentService : Payment successful\n(transactionId)
deactivate PaymentGateway

PaymentService -> PaymentRepository : savePaymentRecord(payment)
activate PaymentRepository
PaymentRepository --> PaymentService : Payment saved
deactivate PaymentRepository

PaymentService -> AssignmentRepository : updateAssignmentPayment(assignmentId, paymentId)
activate AssignmentRepository
AssignmentRepository --> PaymentService : Assignment updated
deactivate AssignmentRepository

PaymentService -> SlotRepository : updateSlotStatus(assignment.slotId, OCCUPIED)
activate SlotRepository
SlotRepository --> PaymentService : Slot status updated
deactivate SlotRepository

PaymentService --> APIGateway : PaymentResponse with receipt
deactivate PaymentService

APIGateway --> MobileApp : 200 OK with payment confirmation
deactivate APIGateway

MobileApp --> Customer : Show payment success and receipt
deactivate MobileApp

' Async post-payment actions
PaymentService -> NotificationService : sendPaymentReceipt(payment)
activate NotificationService
NotificationService -> EmailService : sendReceiptEmail(user, payment)
activate EmailService
EmailService --> NotificationService : Email sent
deactivate EmailService
deactivate NotificationService

PaymentService -> ParkingService : triggerSensorActivation(assignment.slotId)
activate ParkingService
ParkingService -> Sensor : activateBarrier(slotId)
activate Sensor
Sensor --> ParkingService : Barrier opened
deactivate Sensor
deactivate ParkingService

end box

' =============================================
' Diagram 4: Check-out & Release Slot
' =============================================

box "Check-out & Release Slot" #FFF3E0

Customer -> MobileApp : Initiate check-out
activate MobileApp

MobileApp -> APIGateway : POST /api/v1/parking/checkout
activate APIGateway

APIGateway -> AuthService : Validate check-out permissions
activate AuthService
AuthService --> APIGateway : User authenticated
deactivate AuthService

APIGateway -> ParkingService : processCheckout(assignmentId)
activate ParkingService

ParkingService -> AssignmentRepository : findById(assignmentId)
activate AssignmentRepository
AssignmentRepository --> ParkingService : ParkingAssignment
deactivate AssignmentRepository

ParkingService -> Sensor : detectVehicleExit(slotId)
activate Sensor
Sensor --> ParkingService : Vehicle has exited
deactivate Sensor

ParkingService -> PricingService : calculateFinalAmount(assignment)
activate PricingService
PricingService --> ParkingService : finalAmount with any adjustments
deactivate PricingService

ParkingService -> AssignmentRepository : updateCheckoutTime(assignmentId, finalAmount)
activate AssignmentRepository
AssignmentRepository --> ParkingService : Assignment updated
deactivate AssignmentRepository

ParkingService -> SlotRepository : updateStatus(slotId, AVAILABLE)
activate SlotRepository
SlotRepository --> ParkingService : Slot status updated
deactivate SlotRepository

ParkingService --> APIGateway : CheckoutResponse with final receipt
deactivate ParkingService

APIGateway --> MobileApp : 200 OK with checkout confirmation
deactivate APIGateway

MobileApp --> Customer : Show checkout complete and final receipt
deactivate MobileApp

' Async notifications
ParkingService -> NotificationService : sendCheckoutNotification(assignment)
activate NotificationService
NotificationService -> EmailService : sendFinalReceipt(user, assignment)
activate EmailService
EmailService --> NotificationService : Email sent
deactivate EmailService
deactivate NotificationService

end box

' =============================================
' Diagram 5: Handle Overstay Scenario
' =============================================

box "Handle Overstay Detection" #FFEBEE

Sensor -> ParkingService : detectOverstay(slotId)
activate ParkingService

ParkingService -> AssignmentRepository : findActiveBySlot(slotId)
activate AssignmentRepository
AssignmentRepository --> ParkingService : Overstaying assignment
deactivate AssignmentRepository

ParkingService -> PricingService : calculateOvertimeCharges(assignment)
activate PricingService
PricingService --> ParkingService : overtimeAmount
deactivate PricingService

ParkingService -> AssignmentRepository : markAsOverstay(assignmentId, overtimeAmount)
activate AssignmentRepository
AssignmentRepository --> ParkingService : Assignment updated
deactivate AssignmentRepository

ParkingService -> NotificationService : sendOverstayAlert(assignment)
activate NotificationService

NotificationService -> SMSGateway : sendOverstaySMS(user)
activate SMSGateway
SMSGateway --> NotificationService : SMS sent
deactivate SMSGateway

NotificationService -> MobileApp : pushOverstayNotification(user)
activate MobileApp
MobileApp --> NotificationService : Notification delivered
deactivate MobileApp

NotificationService --> ParkingService : Notifications sent
deactivate NotificationService

ParkingService -> PaymentService : createOvertimePayment(assignment)
activate PaymentService
PaymentService -> PaymentRepository : saveOvertimePayment(assignment)
activate PaymentRepository
PaymentRepository --> PaymentService : Payment created
deactivate PaymentRepository
PaymentService --> ParkingService : Overtime payment created
deactivate PaymentService

ParkingService --> Sensor : acknowledgeOverstay()
deactivate ParkingService

end box

' =============================================
' Diagram 6: Real-time Slot Monitoring
' =============================================

box "Real-time Slot Status Updates" #E0F7FA

Sensor -> ParkingService : reportStatusChange(slotId, status)
activate ParkingService

ParkingService -> SlotRepository : updateRealTimeStatus(slotId, status)
activate SlotRepository
SlotRepository --> ParkingService : Status updated
deactivate SlotRepository

ParkingService -> MobileApp : pushSlotStatusUpdate(slotId, status)
activate MobileApp
MobileApp --> ParkingService : Update received
deactivate MobileApp

group Broadcast to all connected clients
    ParkingService -> MobileApp : broadcastAvailabilityUpdate(locationId)
    activate MobileApp
    MobileApp --> ParkingService : Broadcast complete
    deactivate MobileApp
end

ParkingService -> NotificationService : triggerMaintenanceIfNeeded(slotId, status)
activate NotificationService

alt Status = MAINTENANCE_NEEDED
    NotificationService -> EmailService : sendMaintenanceAlert(locationManager, slotId)
    activate EmailService
    EmailService --> NotificationService : Alert sent
    deactivate EmailService
else Status = OUT_OF_SERVICE
    NotificationService -> SMSGateway : sendOutOfServiceAlert(attendant, slotId)
    activate SMSGateway
    SMSGateway --> NotificationService : Alert sent
    deactivate SMSGateway
end

NotificationService --> ParkingService : Maintenance notified
deactivate NotificationService

ParkingService --> Sensor : statusUpdateAcknowledged()
deactivate ParkingService

end box

' =============================================
' Diagram 7: Monthly Billing Process
' =============================================

box "Monthly Billing Process" #F1F8E9

actor "Billing System" as BillingSystem

BillingSystem -> ParkingService : generateMonthlyReport(locationId, month)
activate ParkingService

ParkingService -> AssignmentRepository : findCompletedAssignmentsByMonth(locationId, month)
activate AssignmentRepository
AssignmentRepository --> ParkingService : List<ParkingAssignment>
deactivate AssignmentRepository

ParkingService -> PricingService : aggregateMonthlyRevenue(assignments)
activate PricingService
PricingService --> ParkingService : revenueSummary
deactivate PricingService

ParkingService -> PaymentRepository : getMonthlyPayments(locationId, month)
activate PaymentRepository
PaymentRepository --> ParkingService : List<Payment>
deactivate PaymentRepository

ParkingService -> UserRepository : getCorporateUsers(locationId)
activate UserRepository
UserRepository --> ParkingService : List<User>
deactivate UserRepository

group Generate invoices for corporate users
    loop for each corporate user
        ParkingService -> PaymentService : generateMonthlyInvoice(user, assignments)
        activate PaymentService
        PaymentService --> ParkingService : Invoice generated
        deactivate PaymentService
    end
end

ParkingService --> BillingSystem : MonthlyReport with analytics
deactivate ParkingService

BillingSystem -> NotificationService : sendMonthlyStatements(users)
activate NotificationService

loop for each user with invoice
    NotificationService -> EmailService : sendMonthlyStatement(user, invoice)
    activate EmailService
    EmailService --> NotificationService : Statement sent
    deactivate EmailService
end

NotificationService --> BillingSystem : Statements dispatched
deactivate NotificationService

BillingSystem -> PaymentService : processBatchPayments(invoices)
activate PaymentService

loop for each invoice
    PaymentService -> PaymentGateway : processRecurringPayment(invoice)
    activate PaymentGateway
    PaymentGateway --> PaymentService : Payment processed
    deactivate PaymentGateway
    
    PaymentService -> PaymentRepository : recordBatchPayment(invoice)
    activate PaymentRepository
    PaymentRepository --> PaymentService : Payment recorded
    deactivate PaymentRepository
end

PaymentService --> BillingSystem : Batch payments completed
deactivate PaymentService

end box

' =============================================
' Diagram 8: Error Handling - Payment Failure
' =============================================

box "Error Handling - Payment Failure" #FFECB3

Customer -> MobileApp : Attempt payment
activate MobileApp

MobileApp -> APIGateway : POST /api/v1/payments/process
activate APIGateway

APIGateway -> PaymentService : processPayment(paymentRequest)
activate PaymentService

PaymentService -> PaymentGateway : chargeCustomer(paymentDetails)
activate PaymentGateway

PaymentGateway --> PaymentService : Payment FAILED\n(insufficient funds)
deactivate PaymentGateway

alt First retry
    PaymentService -> PaymentGateway : retryPayment(paymentDetails)
    activate PaymentGateway
    PaymentGateway --> PaymentService : Payment FAILED again
    deactivate PaymentGateway
end

PaymentService -> PaymentRepository : saveFailedPayment(payment, error)
activate PaymentRepository
PaymentRepository --> PaymentService : Failed payment recorded
deactivate PaymentRepository

PaymentService -> AssignmentRepository : markAssignmentPaymentFailed(assignmentId)
activate AssignmentRepository
AssignmentRepository --> PaymentService : Assignment updated
deactivate AssignmentRepository

PaymentService -> NotificationService : sendPaymentFailureAlert(user, assignment)
activate NotificationService
NotificationService -> SMSGateway : sendPaymentFailureSMS(user)
activate SMSGateway
SMSGateway --> NotificationService : SMS sent
deactivate SMSGateway
NotificationService --> PaymentService : Alert sent
deactivate NotificationService

PaymentService -> ParkingService : releaseSlotAfterPaymentFailure(assignmentId)
activate ParkingService
ParkingService -> SlotRepository : updateStatus(slotId, AVAILABLE)
activate SlotRepository
SlotRepository --> ParkingService : Slot released
deactivate SlotRepository
ParkingService --> PaymentService : Slot released
deactivate ParkingService

PaymentService --> APIGateway : PaymentErrorResponse
deactivate PaymentService

APIGateway --> MobileApp : 402 Payment Required with retry options
deactivate APIGateway

MobileApp --> Customer : Show payment failure with retry option
deactivate MobileApp

' Automatic retry after 30 minutes
PaymentService -> PaymentGateway : retryFailedPayment(paymentId)
activate PaymentGateway
PaymentGateway --> PaymentService : Payment SUCCESSFUL
deactivate PaymentGateway

PaymentService -> NotificationService : sendPaymentRecoveryNotification(user)
activate NotificationService
NotificationService -> EmailService : sendRecoveryEmail(user)
activate EmailService
EmailService --> NotificationService : Email sent
deactivate EmailService
deactivate NotificationService

end box

' =============================================
' Legend and Notes
' =============================================

legend top center
    | Color-coded Operations |
    <#E8F5E8> Slot Search & Booking |
    <#E3F2FD> Assignment & QR Generation |
    <#F3E5F5> Payment Processing |
    <#FFF3E0> Check-out & Release |
    <#FFEBEE> Overstay Handling |
    <#E0F7FA> Real-time Monitoring |
    <#F1F8E9> Billing & Reporting |
    <#FFECB3> Error Handling |
    ---
    | Line Styles |
    -> : Synchronous call |
    --> : Response/Return |
    ->> : Asynchronous call |
    -x : Destroy/End |
end legend

note right of Customer
    <b>Key User Actions:</b>
    1. Search for parking
    2. Book a slot
    3. Make payment
    4. Check-out
    5. Handle notifications
end note

note left of PaymentGateway
    <b>External Systems:</b>
    • Payment Gateway (Stripe/PCI)
    • SMS Gateway (Twilio)
    • Email Service (SES/SendGrid)
    • Parking Sensors (IoT)
end note

note bottom of APIGateway
    <b>API Gateway Responsibilities:</b>
    • Authentication/Authorization
    • Rate Limiting
    • Request Validation
    • Response Formatting
    • Circuit Breaking
end note

@enduml