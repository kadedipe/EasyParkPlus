@startuml
' Parking Management System - Class Diagram
' =========================================

title Parking Management System - Class Diagram

skinparam class {
    BackgroundColor<<Entity>> #E1F5FE
    BackgroundColor<<Service>> #F1F8E9
    BackgroundColor<<Controller>> #FFF3E0
    BackgroundColor<<Repository>> #F3E5F5
    BackgroundColor<<DTO>> #FFFDE7
    BackgroundColor<<Enum>> #F5F5F5
    BackgroundColor<<Exception>> #FFEBEE
    BorderColor #37474F
    ArrowColor #37474F
    FontSize 14
}

skinparam {
    shadowing false
    roundcorner 10
    style strictuml
    linetype ortho
}

' =========================================
' Enumerations
' =========================================

enum ParkingSlotType {
    STANDARD
    PREMIUM
    ELECTRIC
    HANDICAP
}

enum ParkingSlotStatus {
    AVAILABLE
    OCCUPIED
    RESERVED
    MAINTENANCE
}

enum VehicleType {
    CAR
    MOTORCYCLE
    VAN
    TRUCK
    ELECTRIC
}

enum AssignmentStatus {
    ACTIVE
    COMPLETED
    CANCELLED
    OVERSTAY
}

enum PaymentStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    REFUNDED
}

enum PaymentMethod {
    CREDIT_CARD
    DEBIT_CARD
    DIGITAL_WALLET
    CASH
}

enum NotificationType {
    EMAIL
    SMS
    PUSH
}

enum UserRole {
    ADMIN
    ATTENDANT
    CUSTOMER
    SYSTEM
}

' =========================================
' Base Classes
' =========================================

abstract class BaseEntity <<Entity>> {
    +id: UUID
    +createdAt: DateTime
    +updatedAt: DateTime
    +isActive: Boolean
    +softDelete(): void
    +activate(): void
    +deactivate(): void
}

class AuditableEntity <<Entity>> {
    +createdBy: String
    +updatedBy: String
    +version: Integer
}

' =========================================
' Core Domain Entities
' =========================================

class Location <<Entity>> {
    +name: String
    +address: String
    +city: String
    +state: String
    +zipCode: String
    +latitude: Double
    +longitude: Double
    +totalSlots: Integer
    +availableSlots: Integer
    +isOperational: Boolean
    +operatingHours: JSON
    +contactInfo: JSON
    +calculateUtilization(): Double
    +updateSlotCount(): void
}

class ParkingSlot <<Entity>> {
    +slotNumber: String
    +slotType: ParkingSlotType
    +status: ParkingSlotStatus
    +floor: Integer
    +zone: String
    +electricCharging: Boolean
    +handicapAccessible: Boolean
    +cameraCoverage: Boolean
    +dimensions: JSON
    +hourlyRate: Decimal
    +maxStayHours: Integer
    +isActive: Boolean
    +assignVehicle(): void
    +releaseVehicle(): void
    +calculateRate(hours): Decimal
    +checkAvailability(): Boolean
}

class Vehicle <<Entity>> {
    +licensePlate: String
    +vehicleType: VehicleType
    +make: String
    +model: String
    +year: Integer
    +color: String
    +ownerId: UUID
    +isElectric: Boolean
    +isHandicap: Boolean
    +registrationExpiry: Date
    +insuranceInfo: JSON
    +validateRegistration(): Boolean
    +updateInsurance(): void
}

class User <<Entity>> {
    +email: String
    +phoneNumber: String
    +firstName: String
    +lastName: String
    +role: UserRole
    +isVerified: Boolean
    +preferences: JSON
    +paymentMethods: List<PaymentMethod>
    +authenticate(password): Boolean
    +updateProfile(): void
    +addPaymentMethod(): void
}

class ParkingAssignment <<Entity>> {
    +assignmentCode: String
    +checkInTime: DateTime
    +checkOutTime: DateTime
    +actualCheckOutTime: DateTime
    +status: AssignmentStatus
    +totalHours: Decimal
    +baseAmount: Decimal
    +taxAmount: Decimal
    +discountAmount: Decimal
    +totalAmount: Decimal
    +notes: String
    +extendStay(hours): void
    +calculateAmount(): Decimal
    +markCompleted(): void
    +applyDiscount(): void
}

class Payment <<Entity>> {
    +paymentReference: String
    +amount: Decimal
    +currency: String
    +status: PaymentStatus
    +method: PaymentMethod
    +transactionId: String
    +processorResponse: JSON
    +billingAddress: JSON
    +receiptUrl: String
    +process(): void
    +refund(): void
    +verify(): Boolean
    +generateReceipt(): String
}

class Invoice <<Entity>> {
    +invoiceNumber: String
    +issueDate: Date
    +dueDate: Date
    +items: List<InvoiceItem>
    +subtotal: Decimal
    +tax: Decimal
    +total: Decimal
    +status: String
    +generatePDF(): Byte[]
    +sendEmail(): void
    +applyPayment(): void
}

class Notification <<Entity>> {
    +type: NotificationType
    +recipient: String
    +subject: String
    +content: String
    +templateName: String
    +templateData: JSON
    +status: String
    +sentAt: DateTime
    +retryCount: Integer
    +send(): void
    +schedule(): void
    +trackDelivery(): void
}

' =========================================
' Support Entities
' =========================================

class PricingRule <<Entity>> {
    +name: String
    +description: String
    +slotType: ParkingSlotType
    +vehicleType: VehicleType
    +timeRange: JSON
    +baseRate: Decimal
    +hourlyRate: Decimal
    +dailyRate: Decimal
    +weeklyRate: Decimal
    +monthlyRate: Decimal
    +discountPercentage: Decimal
    +isActive: Boolean
    +calculateRate(hours): Decimal
    +applyDiscount(amount): Decimal
}

class Discount <<Entity>> {
    +code: String
    +description: String
    +discountType: String
    +value: Decimal
    +maxUses: Integer
    +usedCount: Integer
    +validFrom: Date
    +validTo: Date
    +isActive: Boolean
    +validate(): Boolean
    +apply(): Decimal
    +incrementUsage(): void
}

class AuditLog <<Entity>> {
    +action: String
    +entityType: String
    +entityId: UUID
    +oldValues: JSON
    +newValues: JSON
    +ipAddress: String
    +userAgent: String
    +record(): void
    +getChanges(): JSON
}

class MaintenanceRecord <<Entity>> {
    +title: String
    +description: String
    +slotId: UUID
    +scheduledDate: Date
    +completedDate: Date
    +status: String
    +technician: String
    +cost: Decimal
    +notes: String
    +schedule(): void
    +complete(): void
    +reschedule(): void
}

' =========================================
' DTOs (Data Transfer Objects)
' =========================================

class ParkingSlotDTO <<DTO>> {
    +id: UUID
    +slotNumber: String
    +slotType: String
    +status: String
    +floor: Integer
    +hourlyRate: Decimal
    +isAvailable: Boolean
}

class ParkingAssignmentDTO <<DTO>> {
    +assignmentId: UUID
    +slotNumber: String
    +licensePlate: String
    +checkInTime: DateTime
    +estimatedCheckOut: DateTime
    +totalAmount: Decimal
    +status: String
}

class PaymentRequestDTO <<DTO>> {
    +assignmentId: UUID
    +amount: Decimal
    +paymentMethod: String
    +cardToken: String
    +saveCard: Boolean
}

class SearchCriteriaDTO <<DTO>> {
    +locationId: UUID
    +slotType: String
    +vehicleType: String
    +startTime: DateTime
    +endTime: DateTime
    +sortBy: String
    +sortOrder: String
}

' =========================================
' Service Layer
' =========================================

interface ParkingSlotService <<Service>> {
    +findAvailableSlots(criteria): List<ParkingSlotDTO>
    +assignSlot(request): ParkingAssignmentDTO
    +releaseSlot(assignmentId): void
    +extendStay(assignmentId, hours): ParkingAssignmentDTO
    +getSlotStatus(slotId): ParkingSlotStatus
}

class ParkingSlotServiceImpl <<Service>> {
    -parkingSlotRepository: ParkingSlotRepository
    -assignmentRepository: ParkingAssignmentRepository
    -pricingService: PricingService
    -cacheService: CacheService
    +findAvailableSlots(criteria): List<ParkingSlotDTO>
    +assignSlot(request): ParkingAssignmentDTO
    +releaseSlot(assignmentId): void
    +extendStay(assignmentId, hours): ParkingAssignmentDTO
    +getSlotStatus(slotId): ParkingSlotStatus
    -validateAssignment(): void
    -calculateFees(): Decimal
}

interface PricingService <<Service>> {
    +calculateRate(slotType, vehicleType, hours): Decimal
    +applyDiscount(amount, discountCode): Decimal
    +getCurrentRates(): List<PricingRule>
}

class PricingServiceImpl <<Service>> {
    -pricingRuleRepository: PricingRuleRepository
    -discountRepository: DiscountRepository
    +calculateRate(slotType, vehicleType, hours): Decimal
    +applyDiscount(amount, discountCode): Decimal
    +getCurrentRates(): List<PricingRule>
    -findApplicableRule(): PricingRule
    -validateDiscount(): Boolean
}

interface PaymentService <<Service>> {
    +processPayment(request): PaymentResponse
    +refundPayment(paymentId): void
    +getPaymentStatus(paymentId): PaymentStatus
}

class PaymentServiceImpl <<Service>> {
    -paymentProcessor: PaymentProcessor
    -paymentRepository: PaymentRepository
    -notificationService: NotificationService
    +processPayment(request): PaymentResponse
    +refundPayment(paymentId): void
    +getPaymentStatus(paymentId): PaymentStatus
    -validatePayment(): Boolean
    -handlePaymentFailure(): void
}

interface NotificationService <<Service>> {
    +sendAssignmentNotification(assignment): void
    +sendPaymentNotification(payment): void
    +sendReminderNotification(assignment): void
}

class NotificationServiceImpl <<Service>> {
    -emailService: EmailService
    -smsService: SMSService
    -pushService: PushNotificationService
    +sendAssignmentNotification(assignment): void
    +sendPaymentNotification(payment): void
    +sendReminderNotification(assignment): void
    -prepareTemplate(): String
    -scheduleReminder(): void
}

' =========================================
' Controller Layer
' =========================================

class ParkingSlotController <<Controller>> {
    -parkingSlotService: ParkingSlotService
    +getAvailableSlots(): ResponseEntity<List<ParkingSlotDTO>>
    +assignSlot(): ResponseEntity<ParkingAssignmentDTO>
    +releaseSlot(): ResponseEntity<Void>
    +extendStay(): ResponseEntity<ParkingAssignmentDTO>
    +validate(): void
}

class PaymentController <<Controller>> {
    -paymentService: PaymentService
    +processPayment(): ResponseEntity<PaymentResponse>
    +refundPayment(): ResponseEntity<Void>
    +getPaymentStatus(): ResponseEntity<PaymentStatus>
    +validate(): void
}

class ReportingController <<Controller>> {
    -reportingService: ReportingService
    +getDailyReport(): ResponseEntity<Report>
    +getMonthlyReport(): ResponseEntity<Report>
    +getUtilizationReport(): ResponseEntity<Report>
    +exportReport(): ResponseEntity<ByteArrayResource>
}

' =========================================
' Repository Layer
' =========================================

interface ParkingSlotRepository <<Repository>> {
    +findAvailableSlots(criteria): List<ParkingSlot>
    +findByLocationAndType(locationId, slotType): List<ParkingSlot>
    +updateStatus(slotId, status): void
    +findById(slotId): Optional<ParkingSlot>
    +save(slot): ParkingSlot
}

interface ParkingAssignmentRepository <<Repository>> {
    +findActiveBySlot(slotId): Optional<ParkingAssignment>
    +findByVehicle(vehicleId): List<ParkingAssignment>
    +findActiveAssignments(): List<ParkingAssignment>
    +save(assignment): ParkingAssignment
}

interface PaymentRepository <<Repository>> {
    +findByAssignment(assignmentId): Optional<Payment>
    +findByReference(reference): Optional<Payment>
    +save(payment): Payment
}

interface UserRepository <<Repository>> {
    +findByEmail(email): Optional<User>
    +findByPhone(phone): Optional<User>
    +save(user): User
}

' =========================================
' Relationships
' =========================================

' Core Relationships
Location "1" *-- "*" ParkingSlot : contains
ParkingSlot "1" -- "*" ParkingAssignment : assigned to
Vehicle "1" -- "*" ParkingAssignment : uses
User "1" -- "*" Vehicle : owns
ParkingAssignment "1" -- "1" Payment : paid by
ParkingAssignment "1" -- "*" Invoice : generates

' Service Dependencies
ParkingSlotServiceImpl ..|> ParkingSlotService : implements
PricingServiceImpl ..|> PricingService : implements
PaymentServiceImpl ..|> PaymentService : implements
NotificationServiceImpl ..|> NotificationService : implements

ParkingSlotServiceImpl --> ParkingSlotRepository : uses
ParkingSlotServiceImpl --> PricingService : uses
PricingServiceImpl --> PricingRuleRepository : uses
PaymentServiceImpl --> PaymentProcessor : uses

' Controller Dependencies
ParkingSlotController --> ParkingSlotService : uses
PaymentController --> PaymentService : uses
ReportingController --> ReportingService : uses

' Repository Interfaces
ParkingSlotRepository <|.. JpaParkingSlotRepository : implements
ParkingAssignmentRepository <|.. JpaParkingAssignmentRepository : implements
PaymentRepository <|.. JpaPaymentRepository : implements

' DTO Usage
ParkingSlotService --> ParkingSlotDTO : returns
ParkingSlotController --> ParkingSlotDTO : uses
PaymentController --> PaymentRequestDTO : consumes

' Enum Usage
ParkingSlot --> ParkingSlotType : has
ParkingSlot --> ParkingSlotStatus : has
Vehicle --> VehicleType : has
ParkingAssignment --> AssignmentStatus : has
Payment --> PaymentStatus : has
Payment --> PaymentMethod : has
User --> UserRole : has

' Inheritance
BaseEntity <|-- Location
BaseEntity <|-- ParkingSlot
BaseEntity <|-- Vehicle
BaseEntity <|-- User
BaseEntity <|-- ParkingAssignment
BaseEntity <|-- Payment
BaseEntity <|-- Invoice
BaseEntity <|-- Notification

AuditableEntity <|-- Payment
AuditableEntity <|-- Invoice
AuditableEntity <|-- AuditLog

' Composition
Invoice "1" *-- "*" InvoiceItem : contains
Notification "1" *-- "*" NotificationTemplate : uses

' Aggregation
PricingRule "1" -- "*" ParkingSlot : applies to
Discount "1" -- "*" Payment : applied to
MaintenanceRecord "1" -- "*" ParkingSlot : maintains

' =========================================
' Notes and Comments
' =========================================

note top of ParkingSlotService
    Responsible for managing parking slot
    availability, assignments, and releases.
    Includes business logic for validation
    and fee calculation.
end note

note top of PricingService
    Handles dynamic pricing based on
    slot type, vehicle type, time of day,
    and special rates.
end note

note top of PaymentService
    Integrates with external payment
    gateways and handles transaction
    processing, refunds, and status
    tracking.
end note

note top of ParkingSlot
    Represents individual parking spaces.
    Includes metadata for type, location,
    availability, and pricing.
end note

note top of ParkingAssignment
    Tracks vehicle parking sessions.
    Manages check-in/out times, duration,
    fees, and payment status.
end note

' =========================================
' Legend
' =========================================

legend right
    | Color Legend |
    <#E1F5FE> Entity Classes |
    <#F1F8E9> Service Classes |
    <#FFF3E0> Controller Classes |
    <#F3E5F5> Repository Interfaces |
    <#FFFDE7> DTO Classes |
    <#F5F5F5> Enumerations |
    <#FFEBEE> Exception Classes |
    ---
    | Relationship Types |
    1..* : One to Many |
    * : Many |
    1 : One |
    --|> : Implements |
    --> : Uses/Dependency |
    ..|> : Interface Implementation |
end legend

@enduml