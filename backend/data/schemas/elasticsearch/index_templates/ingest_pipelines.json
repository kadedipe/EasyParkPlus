{
  "pipelines": [
    {
      "name": "parking-event-pipeline",
      "description": "Process parking events",
      "processors": [
        {
          "date": {
            "field": "timestamp",
            "formats": ["UNIX_MS", "ISO8601", "yyyy-MM-dd'T'HH:mm:ss.SSSZ"],
            "target_field": "@timestamp"
          }
        },
        {
          "geoip": {
            "field": "client_ip",
            "target_field": "geo",
            "database_file": "GeoLite2-City.mmdb"
          }
        },
        {
          "user_agent": {
            "field": "user_agent",
            "target_field": "user_agent_info"
          }
        },
        {
          "script": {
            "lang": "painless",
            "source": """
              if (ctx.containsKey('entry_time') && ctx.containsKey('exit_time')) {
                ctx.duration = ctx.exit_time - ctx.entry_time;
                ctx.duration_minutes = ctx.duration / 60000;
                ctx.duration_hours = ctx.duration_minutes / 60;
              }
              if (ctx.containsKey('total_amount') && ctx.containsKey('duration_hours')) {
                ctx.amount_per_hour = ctx.total_amount / ctx.duration_hours;
              }
              ctx.processing_timestamp = new Date().getTime();
            """
          }
        },
        {
          "set": {
            "field": "event_version",
            "value": "1.0"
          }
        },
        {
          "set": {
            "field": "data_stream.dataset",
            "value": "parking.events"
          }
        },
        {
          "remove": {
            "field": ["password", "token", "secret"],
            "ignore_missing": true
          }
        }
      ],
      "on_failure": [
        {
          "set": {
            "field": "error.message",
            "value": "{{ _ingest.on_failure_message }}"
          }
        }
      ]
    },
    {
      "name": "license-plate-normalization",
      "description": "Normalize license plates",
      "processors": [
        {
          "script": {
            "lang": "painless",
            "source": """
              String normalize(String plate) {
                if (plate == null) return null;
                return plate.toUpperCase().replaceAll('[^A-Z0-9]', '');
              }
              if (ctx.vehicle != null) {
                if (ctx.vehicle.license_plate != null) {
                  ctx.vehicle.license_plate_normalized = normalize(ctx.vehicle.license_plate);
                }
                if (ctx.vehicle.entry_lpr_plate != null) {
                  ctx.vehicle.entry_lpr_plate_normalized = normalize(ctx.vehicle.entry_lpr_plate);
                }
                if (ctx.vehicle.exit_lpr_plate != null) {
                  ctx.vehicle.exit_lpr_plate_normalized = normalize(ctx.vehicle.exit_lpr_plate);
                }
              }
              if (ctx.license_plate != null) {
                ctx.license_plate_normalized = normalize(ctx.license_plate);
              }
            """
          }
        }
      ]
    },
    {
      "name": "geolocation-enrichment",
      "description": "Enrich events with geolocation data",
      "processors": [
        {
          "geoip": {
            "field": "ip_address",
            "target_field": "geo",
            "properties": ["country_name", "city_name", "location", "timezone"],
            "ignore_missing": true
          }
        },
        {
          "script": {
            "lang": "painless",
            "source": """
              if (ctx.containsKey('geo') && ctx.geo.containsKey('location')) {
                ctx.location = ctx.geo.location;
              }
              if (ctx.containsKey('coordinates') && ctx.coordinates != null) {
                ctx.location = ctx.coordinates;
              }
            """
          }
        }
      ]
    },
    {
      "name": "parking-session-aggregation",
      "description": "Aggregate parking session data",
      "processors": [
        {
          "script": {
            "lang": "painless",
            "source": """
              if (ctx.entry_time != null) {
                def date = new Date(ctx.entry_time);
                ctx.entry_date = date.format('yyyy-MM-dd');
                ctx.entry_hour = date.getHours();
                ctx.entry_day_of_week = date.getDay();
              }
              if (ctx.exit_time != null) {
                def date = new Date(ctx.exit_time);
                ctx.exit_date = date.format('yyyy-MM-dd');
                ctx.exit_hour = date.getHours();
              }
              if (ctx.duration_minutes != null) {
                if (ctx.duration_minutes < 30) {
                  ctx.duration_bucket = 'under_30min';
                } else if (ctx.duration_minutes < 60) {
                  ctx.duration_bucket = '30-60min';
                } else if (ctx.duration_minutes < 120) {
                  ctx.duration_bucket = '1-2h';
                } else if (ctx.duration_minutes < 240) {
                  ctx.duration_bucket = '2-4h';
                } else if (ctx.duration_minutes < 480) {
                  ctx.duration_bucket = '4-8h';
                } else {
                  ctx.duration_bucket = 'over_8h';
                }
              }
              if (ctx.total_amount != null) {
                if (ctx.total_amount < 5) {
                  ctx.amount_bucket = 'under_5';
                } else if (ctx.total_amount < 10) {
                  ctx.amount_bucket = '5-10';
                } else if (ctx.total_amount < 20) {
                  ctx.amount_bucket = '10-20';
                } else {
                  ctx.amount_bucket = 'over_20';
                }
              }
            """
          }
        }
      ]
    }
  ]
}