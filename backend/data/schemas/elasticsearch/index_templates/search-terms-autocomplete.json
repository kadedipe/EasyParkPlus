{
  "suggesters": {
    "popular_search_terms": {
      "type": "completion",
      "field": "query.normalized",
      "contexts": [
        {
          "name": "user_role",
          "type": "category",
          "path": "user.role"
        },
        {
          "name": "target_type",
          "type": "category",
          "path": "target_type"
        },
        {
          "name": "search_category",
          "type": "category",
          "path": "search_category"
        }
      ],
      "analyzer": "simple",
      "preserve_separators": true,
      "preserve_position_increments": true,
      "max_input_length": 50
    }
  },
  "query": {
    "size": 0,
    "query": {
      "bool": {
        "must": [
          {
            "range": {
              "@timestamp": {
                "gte": "now-90d"
              }
            }
          }
        ],
        "filter": []
      }
    },
    "aggs": {
      "popular_terms": {
        "terms": {
          "field": "query.normalized",
          "size": 1000,
          "order": {
            "search_count": "desc"
          }
        },
        "aggs": {
          "search_count": {
            "value_count": {
              "field": "search_id"
            }
          },
          "avg_score": {
            "avg": {
              "field": "results.max_score"
            }
          },
          "click_rate": {
            "avg": {
              "field": "relevance.click_through"
            }
          },
          "suggestion": {
            "bucket_script": {
              "buckets_path": {
                "count": "_count",
                "clicks": "click_rate"
              },
              "script": "params.count * (1 + params.clicks)"
            }
          }
        }
      }
    }
  }
}