{
  "dashboard": {
    "title": "Search Quality & Analytics Dashboard",
    "description": "Monitor search performance, popular queries, and user behavior",
    "panels": [
      {
        "title": "Search Volume (Last 30 Days)",
        "type": "line",
        "query": {
          "index": "search-logs-*",
          "body": {
            "size": 0,
            "query": {
              "range": {
                "@timestamp": {
                  "gte": "now-30d"
                }
              }
            },
            "aggs": {
              "searches_over_time": {
                "date_histogram": {
                  "field": "@timestamp",
                  "fixed_interval": "1d"
                }
              }
            }
          }
        }
      },
      {
        "title": "Top Search Queries",
        "type": "table",
        "query": {
          "index": "search-logs-*",
          "body": {
            "size": 0,
            "query": {
              "range": {
                "@timestamp": {
                  "gte": "now-7d"
                }
              }
            },
            "aggs": {
              "top_queries": {
                "terms": {
                  "field": "query.normalized",
                  "size": 20
                },
                "aggs": {
                  "avg_results": {
                    "avg": {
                      "field": "results.total"
                    }
                  },
                  "click_rate": {
                    "avg": {
                      "field": "relevance.click_through"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "title": "Search Performance (Response Time)",
        "type": "metric",
        "query": {
          "index": "search-logs-*",
          "body": {
            "size": 0,
            "query": {
              "range": {
                "@timestamp": {
                  "gte": "now-24h"
                }
              }
            },
            "aggs": {
              "avg_response": {
                "avg": {
                  "field": "performance.took_ms"
                }
              },
              "p95_response": {
                "percentiles": {
                  "field": "performance.took_ms",
                  "percents": [95]
                }
              }
            }
          }
        }
      },
      {
        "title": "Zero Result Searches",
        "type": "table",
        "query": {
          "index": "search-logs-*",
          "body": {
            "size": 100,
            "query": {
              "bool": {
                "must": [
                  {
                    "range": {
                      "@timestamp": {
                        "gte": "now-7d"
                      }
                    }
                  },
                  {
                    "term": {
                      "results.total": 0
                    }
                  }
                ]
              }
            },
            "sort": [
              {
                "@timestamp": "desc"
              }
            ]
          }
        }
      },
      {
        "title": "Search by Type",
        "type": "pie",
        "query": {
          "index": "search-logs-*",
          "body": {
            "size": 0,
            "query": {
              "range": {
                "@timestamp": {
                  "gte": "now-7d"
                }
              }
            },
            "aggs": {
              "by_type": {
                "terms": {
                  "field": "search_type"
                }
              }
            }
          }
        }
      },
      {
        "title": "User Click-Through Rate",
        "type": "gauge",
        "query": {
          "index": "search-logs-*",
          "body": {
            "size": 0,
            "query": {
              "range": {
                "@timestamp": {
                  "gte": "now-7d"
                }
              }
            },
            "aggs": {
              "click_rate": {
                "avg": {
                  "field": "relevance.click_through"
                }
              }
            }
          }
        }
      }
    ]
  }
}