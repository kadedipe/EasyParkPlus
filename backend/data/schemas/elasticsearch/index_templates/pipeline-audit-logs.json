{
  "description": "Process audit logs for parking management system",
  "processors": [
    {
      "date": {
        "field": "timestamp",
        "target_field": "@timestamp",
        "formats": ["UNIX_MS", "ISO8601", "yyyy-MM-dd'T'HH:mm:ss.SSSZ", "yyyy-MM-dd HH:mm:ss"],
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "audit.ingest_timestamp",
        "value": "{{_ingest.timestamp}}"
      }
    },
    {
      "geoip": {
        "field": "network.client.ip",
        "target_field": "geo",
        "database_file": "GeoLite2-City.mmdb",
        "properties": ["country_name", "country_code", "city_name", "region_name", "location", "timezone"],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "user_agent": {
        "field": "request.headers.user_agent",
        "target_field": "device",
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "script": {
        "lang": "painless",
        "source": """
          // Set event severity based on action and outcome
          if (ctx.event_outcome == 'failure' || ctx.event_outcome == 'error') {
            ctx.event_severity = 'ERROR';
            ctx.event_priority = 1;
          } else if (ctx.action == 'DELETE' || ctx.action == 'UPDATE') {
            ctx.event_severity = 'WARN';
            ctx.event_priority = 2;
          } else {
            ctx.event_severity = 'INFO';
            ctx.event_priority = 3;
          }
          
          // Calculate duration if not present
          if (ctx.event_duration_ms == null && ctx.performance != null && ctx.performance.execution_time_ms != null) {
            ctx.event_duration_ms = ctx.performance.execution_time_ms;
          }
          
          // Set compliance flags
          if (ctx.resource != null && ctx.resource.type != null) {
            String[] sensitive_types = ['user', 'payment', 'customer', 'employee'];
            for (String type : sensitive_types) {
              if (ctx.resource.type.contains(type)) {
                ctx.compliance = ctx.compliance == null ? new HashMap() : ctx.compliance;
                ctx.compliance.pii_accessed = true;
                break;
              }
            }
          }
          
          // Extract user information if available
          if (ctx.user != null && ctx.user.full_name == null) {
            if (ctx.user.first_name != null && ctx.user.last_name != null) {
              ctx.user.full_name = ctx.user.first_name + ' ' + ctx.user.last_name;
            }
          }
        """
      }
    },
    {
      "remove": {
        "field": [
          "password",
          "token",
          "secret",
          "authorization",
          "cookie"
        ],
        "ignore_missing": true
      }
    },
    {
      "dot_expander": {
        "field": "*",
        "ignore_failure": true
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "error.message",
        "value": "{{ _ingest.on_failure_message }}"
      }
    },
    {
      "set": {
        "field": "error.processor",
        "value": "{{ _ingest.on_failure_processor_type }}"
      }
    }
  ]
}