{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "max_result_window": 10000,
        "mapping": {
          "total_fields": {
            "limit": 500
          }
        },
        "analysis": {
          "analyzer": {
            "license_plate_analyzer": {
              "type": "custom",
              "tokenizer": "keyword",
              "filter": ["lowercase", "trim", "license_plate_pattern"]
            },
            "license_plate_partial_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim"]
            },
            "vehicle_make_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim", "asciifolding"]
            },
            "vehicle_model_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim", "asciifolding"]
            },
            "phonetic_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "phonetic"]
            }
          },
          "filter": {
            "license_plate_pattern": {
              "type": "pattern_replace",
              "pattern": "[^A-Za-z0-9]",
              "replacement": ""
            },
            "phonetic": {
              "type": "phonetic",
              "encoder": "metaphone",
              "replace": false
            }
          },
          "normalizer": {
            "license_plate_normalizer": {
              "type": "custom",
              "filter": ["lowercase", "asciifolding", "trim"]
            }
          }
        },
        "lifecycle": {
          "name": "vehicles-lifecycle",
          "rollover_alias": "vehicles"
        },
        "sort.field": ["license_plate_normalized"],
        "sort.order": ["asc"]
      }
    }
  },
  "version": 1,
  "_meta": {
    "description": "Settings component template for vehicles",
    "managed_by": "parking-management-system"
  }
}