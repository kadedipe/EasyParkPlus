# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parking_db
DB_USER=parking_user
DB_PASSWORD=your_secure_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Elasticsearch Configuration
ELASTICSEARCH_HOSTS=localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_SSL_SHOW_WARN=false
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_MAXSIZE=20

# Application Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here
API_VERSION=v1

# Encryption
ENCRYPTION_KEY=your-encryption-key-here
JWT_SECRET_KEY=your-jwt-secret-key
BCRYPT_ROUNDS=12

# Backup Configuration
BACKUP_DIR=/var/backups/parking
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=parking-backups
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# Monitoring
PROMETHEUS_PORT=8000
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Cloud Providers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=parking-data

GCP_PROJECT_ID=
GCP_BUCKET_NAME=

AZURE_STORAGE_CONNECTION_STRING=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Cache Configuration
CACHE_TTL_USER=86400
CACHE_TTL_PARKING_SPOT=300
CACHE_TTL_RESERVATION=600
CACHE_TTL_RATE=3600

# Performance
QUERY_TIMEOUT=30
CONNECTION_MAX_AGE=3600
PRE_PING=true
USE_FASTEXECUTEMANY=true

# Feature Flags
ENABLE_AUDIT_LOG=true
ENABLE_SOFT_DELETE=true
ENABLE_PARTITIONING=true
ENABLE_CACHING=true
ENABLE_FULL_TEXT_SEARCH=true

# Test Configuration
TEST_DB_NAME=parking_test_db
TEST_REDIS_DB=1
TEST_ELASTICSEARCH_INDEX=test_parking

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@parking.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@parking.com

# Analytics
ANALYTICS_DB_URL=
ANALYTICS_REFRESH_INTERVAL=3600

# Compliance
GDPR_ENABLED=true
PCI_COMPLIANCE=true
DATA_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730