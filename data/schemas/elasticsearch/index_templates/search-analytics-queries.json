{
  "popular_searches": {
    "description": "Most frequent search queries",
    "query": {
      "size": 0,
      "query": {
        "range": {
          "@timestamp": {
            "gte": "now-30d/d",
            "lte": "now/d"
          }
        }
      },
      "aggs": {
        "popular_queries": {
          "terms": {
            "field": "query.normalized",
            "size": 50
          },
          "aggs": {
            "avg_result_count": {
              "avg": {
                "field": "results.total"
              }
            },
            "click_rate": {
              "avg": {
                "field": "relevance.click_through",
                "missing": 0
              }
            },
            "conversion_rate": {
              "avg": {
                "field": "relevance.conversion",
                "missing": 0
              }
            },
            "trend": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d"
              },
              "aggs": {
                "daily_count": {
                  "value_count": {
                    "field": "search_id"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "zero_result_searches": {
    "description": "Searches that returned no results",
    "query": {
      "size": 100,
      "query": {
        "bool": {
          "must": [
            {
              "range": {
                "@timestamp": {
                  "gte": "now-7d/d"
                }
              }
            },
            {
              "term": {
                "results.total": 0
              }
            }
          ]
        }
      },
      "sort": [
        {
          "@timestamp": "desc"
        }
      ]
    }
  },
  "search_performance": {
    "description": "Search performance metrics",
    "query": {
      "size": 0,
      "query": {
        "range": {
          "@timestamp": {
            "gte": "now-24h"
          }
        }
      },
      "aggs": {
        "avg_took_ms": {
          "avg": {
            "field": "performance.took_ms"
          }
        },
        "p95_took_ms": {
          "percentiles": {
            "field": "performance.took_ms",
            "percents": [95]
          }
        },
        "max_took_ms": {
          "max": {
            "field": "performance.took_ms"
          }
        },
        "avg_result_count": {
          "avg": {
            "field": "results.total"
          }
        },
        "error_rate": {
          "filter": {
            "term": {
              "errors.occurred": true
            }
          },
          "aggs": {
            "error_count": {
              "value_count": {
                "field": "search_id"
              }
            }
          }
        }
      }
    }
  },
  "search_trends": {
    "description": "Search volume over time with breakdowns",
    "query": {
      "size": 0,
      "query": {
        "range": {
          "@timestamp": {
            "gte": "now-30d/d"
          }
        }
      },
      "aggs": {
        "over_time": {
          "date_histogram": {
            "field": "@timestamp",
            "fixed_interval": "1d",
            "format": "yyyy-MM-dd"
          },
          "aggs": {
            "total_searches": {
              "value_count": {
                "field": "search_id"
              }
            },
            "unique_users": {
              "cardinality": {
                "field": "user.id"
              }
            },
            "by_type": {
              "terms": {
                "field": "search_type"
              }
            },
            "by_target": {
              "terms": {
                "field": "target_type"
              }
            }
          }
        }
      }
    }
  },
  "user_search_behavior": {
    "description": "Individual user search patterns",
    "query": {
      "size": 0,
      "query": {
        "range": {
          "@timestamp": {
            "gte": "now-30d/d"
          }
        }
      },
      "aggs": {
        "top_users": {
          "terms": {
            "field": "user.id",
            "size": 20
          },
          "aggs": {
            "search_count": {
              "value_count": {
                "field": "search_id"
              }
            },
            "avg_query_length": {
              "avg": {
                "field": "query.length"
              }
            },
            "avg_result_count": {
              "avg": {
                "field": "results.total"
              }
            },
            "click_rate": {
              "avg": {
                "field": "relevance.click_through",
                "missing": 0
              }
            },
            "top_queries": {
              "terms": {
                "field": "query.normalized",
                "size": 5
              }
            }
          }
        }
      }
    }
  },
  "search_ab_testing": {
    "description": "A/B test results for search experiments",
    "query": {
      "size": 0,
      "query": {
        "bool": {
          "must": [
            {
              "exists": {
                "field": "ab_testing.experiment_id"
              }
            },
            {
              "range": {
                "@timestamp": {
                  "gte": "now-30d/d"
                }
              }
            }
          ]
        }
      },
      "aggs": {
        "by_experiment": {
          "terms": {
            "field": "ab_testing.experiment_id"
          },
          "aggs": {
            "by_variant": {
              "terms": {
                "field": "ab_testing.variant"
              },
              "aggs": {
                "search_count": {
                  "value_count": {
                    "field": "search_id"
                  }
                },
                "avg_took_ms": {
                  "avg": {
                    "field": "performance.took_ms"
                  }
                },
                "avg_result_count": {
                  "avg": {
                    "field": "results.total"
                  }
                },
                "click_rate": {
                  "avg": {
                    "field": "relevance.click_through",
                    "missing": 0
                  }
                },
                "conversion_rate": {
                  "avg": {
                    "field": "relevance.conversion",
                    "missing": 0
                  }
                }
              }
            },
            "statistical_significance": {
              "bucket_script": {
                "buckets_path": {
                  "control_clicks": "by_variant['control']>click_rate",
                  "variant_clicks": "by_variant['test']>click_rate"
                },
                "script": "Math.abs(params.control_clicks - params.variant_clicks) / Math.sqrt((params.control_clicks + params.variant_clicks) / 2)"
              }
            }
          }
        }
      }
    }
  }
}