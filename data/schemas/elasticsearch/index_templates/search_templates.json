{
  "templates": [
    {
      "name": "search_vehicles_by_plate",
      "template": {
        "index": "vehicle-events-*",
        "query": {
          "bool": {
            "must": [
              {
                "match": {
                  "vehicle.license_plate.partial": "{{plate}}"
                }
              }
            ],
            "filter": [
              {
                "range": {
                  "timestamp": {
                    "gte": "{{date_range_start}}",
                    "lte": "{{date_range_end}}"
                  }
                }
              }
            ]
          }
        },
        "sort": [
          {
            "timestamp": {
              "order": "desc"
            }
          }
        ],
        "size": "{{size}}"
      }
    },
    {
      "name": "parking_lot_occupancy",
      "template": {
        "index": "parking-events-*",
        "query": {
          "bool": {
            "must": [
              {
                "term": {
                  "parking_lot.id": "{{lot_id}}"
                }
              },
              {
                "terms": {
                  "event_type": ["occupancy_change", "session_start", "session_end"]
                }
              }
            ],
            "filter": [
              {
                "range": {
                  "timestamp": {
                    "gte": "{{start_time}}",
                    "lte": "{{end_time}}"
                  }
                }
              }
            ]
          }
        },
        "aggs": {
          "occupancy_over_time": {
            "date_histogram": {
              "field": "timestamp",
              "fixed_interval": "{{interval}}",
              "time_zone": "{{timezone}}"
            },
            "aggs": {
              "avg_occupancy": {
                "avg": {
                  "field": "occupancy.occupied_spaces"
                }
              },
              "max_occupancy": {
                "max": {
                  "field": "occupancy.occupied_spaces"
                }
              },
              "min_occupancy": {
                "min": {
                  "field": "occupancy.occupied_spaces"
                }
              }
            }
          },
          "avg_occupancy_rate": {
            "avg": {
              "field": "occupancy.occupancy_rate"
            }
          }
        }
      }
    },
    {
      "name": "revenue_analysis",
      "template": {
        "index": "payments-*",
        "query": {
          "bool": {
            "must": [
              {
                "term": {
                  "status": "completed"
                }
              }
            ],
            "filter": [
              {
                "range": {
                  "timestamp": {
                    "gte": "{{start_date}}",
                    "lte": "{{end_date}}"
                  }
                }
              }
            ]
          }
        },
        "aggs": {
          "revenue_by_lot": {
            "terms": {
              "field": "location.lot_id",
              "size": 10
            },
            "aggs": {
              "total_revenue": {
                "sum": {
                  "field": "amounts.total"
                }
              },
              "avg_transaction": {
                "avg": {
                  "field": "amounts.total"
                }
              },
              "transaction_count": {
                "value_count": {
                  "field": "payment_id"
                }
              },
              "revenue_by_method": {
                "terms": {
                  "field": "payment_method"
                },
                "aggs": {
                  "method_revenue": {
                    "sum": {
                      "field": "amounts.total"
                    }
                  }
                }
              },
              "revenue_by_hour": {
                "date_histogram": {
                  "field": "timestamp",
                  "fixed_interval": "1h",
                  "format": "HH"
                },
                "aggs": {
                  "hour_revenue": {
                    "sum": {
                      "field": "amounts.total"
                    }
                  }
                }
              }
            }
          },
          "total_revenue": {
            "sum": {
              "field": "amounts.total"
            }
          },
          "avg_daily_revenue": {
            "avg": {
              "script": {
                "source": "doc['amounts.total'].value"
              }
            }
          }
        }
      }
    },
    {
      "name": "vehicle_history",
      "template": {
        "index": "vehicle-events-*",
        "query": {
          "bool": {
            "must": [
              {
                "term": {
                  "vehicle.license_plate_normalized": "{{normalized_plate}}"
                }
              }
            ]
          }
        },
        "sort": [
          {
            "timestamp": {
              "order": "desc"
            }
          }
        ],
        "aggs": {
          "visit_summary": {
            "terms": {
              "field": "event_type"
            }
          },
          "lots_visited": {
            "terms": {
              "field": "location.lot_id",
              "size": 10
            },
            "aggs": {
              "visit_count": {
                "value_count": {
                  "field": "_id"
                }
              },
              "last_visit": {
                "max": {
                  "field": "timestamp"
                }
              }
            }
          },
          "total_duration": {
            "sum": {
              "field": "session.duration_minutes"
            }
          },
          "avg_duration": {
            "avg": {
              "field": "session.duration_minutes"
            }
          }
        }
      }
    },
    {
      "name": "user_activity_timeline",
      "template": {
        "index": "user-activity-*",
        "query": {
          "bool": {
            "must": [
              {
                "term": {
                  "user_id": "{{user_id}}"
                }
              }
            ],
            "filter": [
              {
                "range": {
                  "timestamp": {
                    "gte": "{{start_time}}",
                    "lte": "{{end_time}}"
                  }
                }
              }
            ]
          }
        },
        "sort": [
          {
            "timestamp": {
              "order": "desc"
            }
          }
        ],
        "aggs": {
          "activity_by_type": {
            "terms": {
              "field": "activity_type"
            }
          },
          "activity_by_hour": {
            "date_histogram": {
              "field": "timestamp",
              "fixed_interval": "1h",
              "format": "HH"
            }
          },
          "activity_by_day": {
            "date_histogram": {
              "field": "timestamp",
              "fixed_interval": "1d",
              "format": "yyyy-MM-dd"
            }
          },
          "avg_response_time": {
            "avg": {
              "field": "duration_ms"
            }
          },
          "error_rate": {
            "filter": {
              "term": {
                "result": "error"
              }
            },
            "aggs": {
              "error_count": {
                "value_count": {
                  "field": "_id"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "sensor_anomaly_detection",
      "template": {
        "index": "sensor-data-*",
        "query": {
          "bool": {
            "must": [
              {
                "term": {
                  "sensor_id": "{{sensor_id}}"
                }
              },
              {
                "range": {
                  "timestamp": {
                    "gte": "now-{{time_range}}"
                  }
                }
              }
            ]
          }
        },
        "aggs": {
          "stats": {
            "extended_stats": {
              "field": "value"
            }
          },
          "outliers": {
            "percentiles": {
              "field": "value",
              "percents": [1, 5, 95, 99]
            }
          },
          "over_time": {
            "date_histogram": {
              "field": "timestamp",
              "fixed_interval": "{{interval}}"
            },
            "aggs": {
              "avg_value": {
                "avg": {
                  "field": "value"
                }
              },
              "min_value": {
                "min": {
                  "field": "value"
                }
              },
              "max_value": {
                "max": {
                  "field": "value"
                }
              },
              "std_dev": {
                "extended_stats": {
                  "field": "value"
                }
              }
            }
          }
        }
      }
    }
  ]
}