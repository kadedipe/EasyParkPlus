{
  "description": "Process search logs for analytics",
  "processors": [
    {
      "date": {
        "field": "timestamp",
        "target_field": "@timestamp",
        "formats": ["UNIX_MS", "ISO8601", "yyyy-MM-dd'T'HH:mm:ss.SSSZ"],
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "search_id",
        "value": "{{_id}}",
        "override": false
      }
    },
    {
      "script": {
        "lang": "painless",
        "source": """
          // Normalize search query
          if (ctx.query != null && ctx.query.original != null) {
            String query = ctx.query.original.toLowerCase().trim();
            ctx.query.normalized = query.replaceAll('[^a-z0-9\\s]', '');
            ctx.query.length = query.length();
            
            // Split into terms
            String[] terms = query.split('\\s+');
            ctx.query.terms = terms;
            ctx.query.word_count = terms.length;
            
            // Detect query features
            ctx.query.has_wildcard = query.contains('*') || query.contains('?');
            ctx.query.has_fuzzy = query.contains('~');
            ctx.query.has_phrase = query.contains('"');
            ctx.query.has_boolean = query.contains(' AND ') || query.contains(' OR ') || query.contains(' NOT ');
            ctx.query.has_range = query.contains('[') || query.contains(' TO ');
            ctx.query.has_geo = query.contains('geo') || query.contains('location');
            
            // Calculate complexity score
            float complexity = 1.0;
            if (ctx.query.has_wildcard) complexity += 0.5;
            if (ctx.query.has_fuzzy) complexity += 0.3;
            if (ctx.query.has_phrase) complexity += 0.2;
            if (ctx.query.has_boolean) complexity += 0.4;
            if (ctx.query.has_range) complexity += 0.3;
            if (ctx.query.word_count > 3) complexity += 0.2;
            ctx.query.complexity_score = complexity;
          }
          
          // Calculate result metrics
          if (ctx.results != null) {
            if (ctx.results.max_score != null && ctx.results.min_score != null) {
              ctx.results.score_range = ctx.results.max_score - ctx.results.min_score;
            }
            if (ctx.results.returned != null && ctx.results.returned > 0) {
              ctx.results.has_results = true;
            }
          }
          
          // Calculate success metrics
          ctx.success = ctx.errors == null || ctx.errors.occurred == false;
          
          // Set default pagination
          if (ctx.pagination == null) {
            ctx.pagination = new HashMap();
            ctx.pagination.from = 0;
            ctx.pagination.size = 10;
            ctx.pagination.page = 1;
          } else {
            if (ctx.pagination.from != null && ctx.pagination.size != null) {
              ctx.pagination.page = (ctx.pagination.from / ctx.pagination.size) + 1;
            }
          }
          
          // Calculate total pages
          if (ctx.results != null && ctx.results.total != null && ctx.pagination.size != null && ctx.pagination.size > 0) {
            ctx.pagination.total_pages = (int) Math.ceil((double) ctx.results.total / ctx.pagination.size);
          }
        """
      }
    },
    {
      "geoip": {
        "field": "ip_address",
        "target_field": "geo",
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "user_agent": {
        "field": "user_agent",
        "target_field": "device",
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "remove": {
        "field": [
          "user_agent",
          "ip_address"
        ],
        "ignore_missing": true
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "error.message",
        "value": "{{ _ingest.on_failure_message }}"
      }
    }
  ]
}