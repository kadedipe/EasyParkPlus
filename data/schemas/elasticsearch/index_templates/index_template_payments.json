{
  "index_patterns": ["payments-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "lifecycle": {
          "name": "payments-lifecycle",
          "rollover_alias": "payments"
        }
      }
    },
    "mappings": {
      "properties": {
        "payment_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "transaction_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "payment_number": {
          "type": "keyword",
          "ignore_above": 256
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "payment_date": {
          "type": "date",
          "format": "yyyy-MM-dd"
        },
        "payment_time": {
          "type": "date",
          "format": "HH:mm:ss"
        },
        "status": {
          "type": "keyword",
          "ignore_above": 256
        },
        "amounts": {
          "properties": {
            "subtotal": {
              "type": "float"
            },
            "tax": {
              "type": "float"
            },
            "tip": {
              "type": "float"
            },
            "discount": {
              "type": "float"
            },
            "total": {
              "type": "float"
            },
            "paid": {
              "type": "float"
            },
            "refunded": {
              "type": "float"
            },
            "due": {
              "type": "float"
            },
            "currency": {
              "type": "keyword",
              "ignore_above": 256
            },
            "exchange_rate": {
              "type": "float"
            },
            "original_currency": {
              "type": "keyword",
              "ignore_above": 256
            },
            "original_amount": {
              "type": "float"
            }
          }
        },
        "payment_method": {
          "type": "keyword",
          "ignore_above": 256
        },
        "payment_type": {
          "type": "keyword",
          "ignore_above": 256
        },
        "card": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "brand": {
              "type": "keyword",
              "ignore_above": 256
            },
            "last_four": {
              "type": "keyword",
              "ignore_above": 256
            },
            "expiry_month": {
              "type": "byte"
            },
            "expiry_year": {
              "type": "integer"
            },
            "issuer": {
              "type": "keyword",
              "ignore_above": 256
            },
            "country": {
              "type": "keyword",
              "ignore_above": 256
            },
            "fingerprint": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "digital_wallet": {
          "properties": {
            "provider": {
              "type": "keyword",
              "ignore_above": 256
            },
            "wallet_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "email": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        "cash": {
          "properties": {
            "amount_tendered": {
              "type": "float"
            },
            "change_given": {
              "type": "float"
            },
            "currency": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "transaction": {
          "properties": {
            "authorization_code": {
              "type": "keyword",
              "ignore_above": 256
            },
            "reference_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "batch_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "terminal_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "merchant_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "response_code": {
              "type": "keyword",
              "ignore_above": 256
            },
            "response_message": {
              "type": "text"
            },
            "avs_result": {
              "type": "keyword",
              "ignore_above": 256
            },
            "cvv_result": {
              "type": "keyword",
              "ignore_above": 256
            },
            "processor": {
              "type": "keyword",
              "ignore_above": 256
            },
            "processor_response": {
              "type": "text"
            }
          }
        },
        "refund": {
          "properties": {
            "original_payment_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "refund_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "amount": {
              "type": "float"
            },
            "reason": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "timestamp": {
              "type": "date"
            },
            "status": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "customer": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "email": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "phone": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "customer_type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "customer_code": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "parking_session": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "session_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "ticket_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "entry_time": {
              "type": "date"
            },
            "exit_time": {
              "type": "date"
            },
            "duration_minutes": {
              "type": "integer"
            }
          }
        },
        "reservation": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "reservation_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "start_time": {
              "type": "date"
            },
            "end_time": {
              "type": "date"
            }
          }
        },
        "location": {
          "properties": {
            "lot_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "lot_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "terminal_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "gate_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "kiosk_id": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "operator": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "username": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        "fraud": {
          "properties": {
            "score": {
              "type": "float"
            },
            "flags": {
              "type": "keyword",
              "ignore_above": 256
            },
            "rules_triggered": {
              "type": "text"
            },
            "review_required": {
              "type": "boolean"
            },
            "risk_level": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "reconciliation": {
          "properties": {
            "batch_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "settlement_date": {
              "type": "date"
            },
            "reconciled": {
              "type": "boolean"
            },
            "reconciled_at": {
              "type": "date"
            },
            "discrepancy": {
              "type": "float"
            },
            "notes": {
              "type": "text"
            }
          }
        },
        "audit": {
          "properties": {
            "created_at": {
              "type": "date"
            },
            "created_by": {
              "type": "keyword",
              "ignore_above": 256
            },
            "updated_at": {
              "type": "date"
            },
            "updated_by": {
              "type": "keyword",
              "ignore_above": 256
            },
            "ip_address": {
              "type": "ip"
            },
            "user_agent": {
              "type": "text"
            }
          }
        }
      }
    }
  },
  "composed_of": ["component_base_settings", "component_base_mappings"],
  "priority": 100,
  "version": 1,
  "_meta": {
    "description": "Index template for payment transactions",
    "managed_by": "parking-management-system",
    "version": "1.0.0"
  }
}