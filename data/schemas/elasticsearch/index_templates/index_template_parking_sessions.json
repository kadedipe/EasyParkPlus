{
  "index_patterns": ["parking-sessions-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 5,
        "number_of_replicas": 1,
        "refresh_interval": "30s",
        "lifecycle": {
          "name": "parking-sessions-lifecycle",
          "rollover_alias": "parking-sessions"
        },
        "sort.field": ["entry_time"],
        "sort.order": ["desc"],
        "codec": "best_compression"
      }
    },
    "mappings": {
      "properties": {
        "session_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "ticket_number": {
          "type": "keyword",
          "ignore_above": 256
        },
        "entry_time": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "entry_date": {
          "type": "date",
          "format": "yyyy-MM-dd"
        },
        "entry_hour": {
          "type": "byte"
        },
        "entry_day_of_week": {
          "type": "byte"
        },
        "exit_time": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "exit_date": {
          "type": "date",
          "format": "yyyy-MM-dd"
        },
        "exit_hour": {
          "type": "byte"
        },
        "duration": {
          "properties": {
            "minutes": {
              "type": "integer"
            },
            "hours": {
              "type": "float"
            },
            "days": {
              "type": "float"
            },
            "bucket": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "status": {
          "type": "keyword",
          "ignore_above": 256
        },
        "payment": {
          "properties": {
            "status": {
              "type": "keyword",
              "ignore_above": 256
            },
            "method": {
              "type": "keyword",
              "ignore_above": 256
            },
            "amount": {
              "type": "float"
            },
            "currency": {
              "type": "keyword",
              "ignore_above": 256
            },
            "time": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            },
            "bucket": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "revenue": {
          "properties": {
            "base": {
              "type": "float"
            },
            "tax": {
              "type": "float"
            },
            "discount": {
              "type": "float"
            },
            "total": {
              "type": "float"
            },
            "net": {
              "type": "float"
            },
            "per_hour": {
              "type": "float"
            },
            "per_minute": {
              "type": "float"
            }
          }
        },
        "vehicle": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "license_plate": {
              "type": "text",
              "analyzer": "license_plate_analyzer",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256,
                  "normalizer": "lowercase_normalizer"
                },
                "partial": {
                  "type": "text",
                  "analyzer": "partial_plate_analyzer"
                }
              }
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "make": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "model": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "color": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "year": {
              "type": "integer"
            },
            "is_electric": {
              "type": "boolean"
            },
            "is_handicapped": {
              "type": "boolean"
            },
            "is_resident": {
              "type": "boolean"
            }
          }
        },
        "customer": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "email": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "phone": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "membership_level": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "location": {
          "properties": {
            "lot_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "lot_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "level_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_number": {
              "type": "integer"
            },
            "space_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "space_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "space_type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "coordinates": {
              "type": "geo_point"
            }
          }
        },
        "rate": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "base": {
              "type": "float"
            },
            "unit": {
              "type": "keyword",
              "ignore_above": 256
            },
            "currency": {
              "type": "keyword",
              "ignore_above": 256
            },
            "tiers": {
              "type": "nested",
              "properties": {
                "min_duration": {
                  "type": "integer"
                },
                "max_duration": {
                  "type": "integer"
                },
                "rate": {
                  "type": "float"
                }
              }
            }
          }
        },
        "operator": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "created_by": {
              "type": "keyword",
              "ignore_above": 256
            },
            "ended_by": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "metrics": {
          "properties": {
            "has_lpr_match": {
              "type": "boolean"
            },
            "lpr_confidence_avg": {
              "type": "float"
            },
            "grace_period_used": {
              "type": "boolean"
            },
            "overtime_minutes": {
              "type": "integer"
            },
            "early_exit_minutes": {
              "type": "integer"
            }
          }
        },
        "aggregates": {
          "properties": {
            "daily": {
              "type": "object",
              "dynamic": true
            },
            "weekly": {
              "type": "object",
              "dynamic": true
            },
            "monthly": {
              "type": "object",
              "dynamic": true
            },
            "yearly": {
              "type": "object",
              "dynamic": true
            }
          }
        }
      }
    }
  },
  "composed_of": ["component_base_settings", "component_base_mappings"],
  "priority": 100,
  "version": 1,
  "_meta": {
    "description": "Index template for parking sessions",
    "managed_by": "parking-management-system",
    "version": "1.0.0"
  }
}