{
  "template": {
    "mappings": {
      "_source": {
        "enabled": true,
        "excludes": [
          "results.top_hits.sources",
          "performance.profile"
        ]
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        {
          "search_terms": {
            "match": "query.terms",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "search_facets": {
            "match": "facet_*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "search_metrics": {
            "match": "*_count|*_score|*_rate",
            "match_pattern": "regex",
            "mapping": {
              "type": "float"
            }
          }
        },
        {
          "durations": {
            "match": "*_ms",
            "match_pattern": "regex",
            "mapping": {
              "type": "integer"
            }
          }
        },
        {
          "booleans": {
            "match_mapping_type": "boolean",
            "mapping": {
              "type": "boolean"
            }
          }
        },
        {
          "geo_points": {
            "match": "*_coordinates|location",
            "mapping": {
              "type": "geo_point"
            }
          }
        }
      ]
    }
  },
  "version": 1,
  "_meta": {
    "description": "Mappings component template for search logs",
    "managed_by": "parking-management-system"
  }
}