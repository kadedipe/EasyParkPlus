{
  "index_patterns": ["user-activity-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "lifecycle": {
          "name": "user-activity-lifecycle",
          "rollover_alias": "user-activity"
        }
      }
    },
    "mappings": {
      "properties": {
        "user_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "username": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "email": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "full_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "role": {
          "type": "keyword",
          "ignore_above": 256
        },
        "organization": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        "session_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "activity_type": {
          "type": "keyword",
          "ignore_above": 256
        },
        "activity_category": {
          "type": "keyword",
          "ignore_above": 256
        },
        "action": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "resource": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "url": {
              "type": "text"
            }
          }
        },
        "details": {
          "type": "object",
          "dynamic": true
        },
        "result": {
          "type": "keyword",
          "ignore_above": 256
        },
        "status_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "location": {
          "properties": {
            "lot_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "lot_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "gate_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "terminal_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "ip_address": {
              "type": "ip"
            },
            "geo_point": {
              "type": "geo_point"
            }
          }
        },
        "device": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "os": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "browser": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "version": {
              "type": "keyword",
              "ignore_above": 256
            },
            "is_mobile": {
              "type": "boolean"
            }
          }
        },
        "metrics": {
          "properties": {
            "api_calls": {
              "type": "integer"
            },
            "sessions_started": {
              "type": "integer"
            },
            "sessions_ended": {
              "type": "integer"
            },
            "payments_processed": {
              "type": "integer"
            },
            "reservations_made": {
              "type": "integer"
            },
            "gates_operated": {
              "type": "integer"
            },
            "reports_generated": {
              "type": "integer"
            }
          }
        },
        "daily_aggregates": {
          "properties": {
            "date": {
              "type": "date",
              "format": "yyyy-MM-dd"
            },
            "total_activities": {
              "type": "integer"
            },
            "unique_sessions": {
              "type": "integer"
            },
            "avg_duration_seconds": {
              "type": "float"
            },
            "peak_hour": {
              "type": "byte"
            },
            "most_common_action": {
              "type": "keyword",
              "ignore_above": 256
            },
            "activity_by_hour": {
              "type": "object",
              "dynamic": true
            },
            "activity_by_type": {
              "type": "object",
              "dynamic": true
            }
          }
        },
        "metadata": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "composed_of": ["component_base_settings", "component_base_mappings"],
  "priority": 100,
  "version": 1,
  "_meta": {
    "description": "Index template for user activity",
    "managed_by": "parking-management-system",
    "version": "1.0.0"
  }
}