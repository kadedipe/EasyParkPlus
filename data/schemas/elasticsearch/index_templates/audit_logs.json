{
  "index_patterns": ["audit-logs-*", "audit-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "30s",
        "max_result_window": 50000,
        "mapping": {
          "total_fields": {
            "limit": 1500
          }
        },
        "analysis": {
          "analyzer": {
            "audit_message_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "stop", "snowball"]
            },
            "audit_path_analyzer": {
              "type": "custom",
              "tokenizer": "path_hierarchy",
              "filter": ["lowercase"]
            }
          }
        }
      }
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        {
          "audit_fields": {
            "match": "audit_*",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        {
          "user_fields": {
            "match": "user_*",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "audit_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "audit_version": {
          "type": "keyword",
          "ignore_above": 32
        },
        "event_type": {
          "type": "keyword",
          "ignore_above": 100
        },
        "event_category": {
