{
  "index_patterns": ["sensor-data-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 5,
        "number_of_replicas": 1,
        "refresh_interval": "1s",
        "lifecycle": {
          "name": "sensor-data-lifecycle",
          "rollover_alias": "sensor-data"
        },
        "sort.field": ["timestamp"],
        "sort.order": ["desc"],
        "codec": "best_compression"
      }
    },
    "mappings": {
      "properties": {
        "sensor_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "sensor_type": {
          "type": "keyword",
          "ignore_above": 256
        },
        "sensor_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "date": {
          "type": "date",
          "format": "yyyy-MM-dd"
        },
        "hour": {
          "type": "byte"
        },
        "minute": {
          "type": "byte"
        },
        "second": {
          "type": "byte"
        },
        "value": {
          "type": "float"
        },
        "raw_value": {
          "type": "text"
        },
        "unit": {
          "type": "keyword",
          "ignore_above": 256
        },
        "status": {
          "type": "keyword",
          "ignore_above": 256
        },
        "quality": {
          "properties": {
            "confidence": {
              "type": "float"
            },
            "accuracy": {
              "type": "float"
            },
            "precision": {
              "type": "float"
            },
            "rssi": {
              "type": "integer"
            },
            "snr": {
              "type": "float"
            },
            "battery_level": {
              "type": "float"
            },
            "signal_strength": {
              "type": "integer"
            },
            "error_rate": {
              "type": "float"
            }
          }
        },
        "measurement": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "min": {
              "type": "float"
            },
            "max": {
              "type": "float"
            },
            "avg": {
              "type": "float"
            },
            "median": {
              "type": "float"
            },
            "std_dev": {
              "type": "float"
            },
            "count": {
              "type": "integer"
            },
            "sum": {
              "type": "float"
            }
          }
        },
        "occupancy": {
          "properties": {
            "is_occupied": {
              "type": "boolean"
            },
            "occupied_since": {
              "type": "date"
            },
            "occupied_duration_seconds": {
              "type": "integer"
            },
            "vacancy_duration_seconds": {
              "type": "integer"
            },
            "occupancy_changes": {
              "type": "integer"
            },
            "last_change": {
              "type": "date"
            }
          }
        },
        "environmental": {
          "properties": {
            "temperature": {
              "type": "float"
            },
            "humidity": {
              "type": "float"
            },
            "pressure": {
              "type": "float"
            },
            "light_level": {
              "type": "float"
            },
            "noise_level": {
              "type": "float"
            },
            "air_quality": {
              "type": "float"
            },
            "co2_level": {
              "type": "float"
            },
            "weather_condition": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "location": {
          "properties": {
            "lot_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "lot_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "level_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_number": {
              "type": "integer"
            },
            "space_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "space_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "zone": {
              "type": "keyword",
              "ignore_above": 256
            },
            "coordinates": {
              "type": "geo_point"
            },
            "position": {
              "properties": {
                "x": {
                  "type": "float"
                },
                "y": {
                  "type": "float"
                },
                "z": {
                  "type": "float"
                }
              }
            }
          }
        },
        "event": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "triggered": {
              "type": "boolean"
            },
            "threshold": {
              "type": "float"
            },
            "duration": {
              "type": "integer"
            }
          }
        },
        "device": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "model": {
              "type": "keyword",
              "ignore_above": 256
            },
            "manufacturer": {
              "type": "keyword",
              "ignore_above": 256
            },
            "firmware_version": {
              "type": "keyword",
              "ignore_above": 256
            },
            "hardware_version": {
              "type": "keyword",
              "ignore_above": 256
            },
            "serial_number": {
              "type": "keyword",
              "ignore_above": 256
            },
            "ip_address": {
              "type": "ip"
            },
            "mac_address": {
              "type": "keyword",
              "ignore_above": 256
            },
            "last_seen": {
              "type": "date"
            },
            "status": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "calibration": {
          "properties": {
            "last_calibration": {
              "type": "date"
            },
            "next_calibration": {
              "type": "date"
            },
            "calibration_factor": {
              "type": "float"
            },
            "offset": {
              "type": "float"
            },
            "scale": {
              "type": "float"
            }
          }
        },
        "alerts": {
          "properties": {
            "has_alert": {
              "type": "boolean"
            },
            "alert_level": {
              "type": "keyword",
              "ignore_above": 256
            },
            "alert_message": {
              "type": "text"
            },
            "alert_code": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "maintenance": {
          "properties": {
            "needs_maintenance": {
              "type": "boolean"
            },
            "maintenance_due": {
              "type": "date"
            },
            "error_count": {
              "type": "integer"
            },
            "uptime_seconds": {
              "type": "integer"
            }
          }
        },
        "metadata": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "composed_of": ["component_base_settings", "component_base_mappings"],
  "priority": 100,
  "version": 1,
  "_meta": {
    "description": "Index template for sensor data",
    "managed_by": "parking-management-system",
    "version": "1.0.0"
  }
}