{
  "index_patterns": ["*"],
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "event_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "event_type": {
          "type": "keyword",
          "ignore_above": 256
        },
        "event_version": {
          "type": "keyword",
          "ignore_above": 256
        },
        "data_stream": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "dataset": {
              "type": "keyword",
              "ignore_above": 256
            },
            "namespace": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "organization": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "code": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "tags": {
          "type": "keyword",
          "ignore_above": 256
        },
        "labels": {
          "type": "object",
          "dynamic": true
        },
        "metadata": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "priority": 2,
  "version": 1
}