{
  "index_patterns": ["geolocation-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "lifecycle": {
          "name": "geolocation-lifecycle",
          "rollover_alias": "geolocation"
        }
      }
    },
    "mappings": {
      "properties": {
        "entity_type": {
          "type": "keyword",
          "ignore_above": 256
        },
        "entity_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "entity_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "location": {
          "type": "geo_point"
        },
        "location_bounds": {
          "type": "geo_shape"
        },
        "address": {
          "properties": {
            "full": {
              "type": "text",
              "analyzer": "address_analyzer"
            },
            "street": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "city": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "state": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "country": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "postal_code": {
              "type": "keyword",
              "ignore_above": 256
            },
            "timezone": {
              "type": "keyword",
              "ignore_above": 256
            },
            "formatted": {
              "type": "text"
            }
          }
        },
        "geohash": {
          "type": "keyword",
          "ignore_above": 256
        },
        "geohash_cells": {
          "properties": {
            "level_1": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_2": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_3": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_4": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_5": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_6": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_7": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_8": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_9": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_10": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_11": {
              "type": "keyword",
              "ignore_above": 256
            },
            "level_12": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "altitude": {
          "type": "float"
        },
        "accuracy": {
          "properties": {
            "horizontal": {
              "type": "float"
            },
            "vertical": {
              "type": "float"
            }
          }
        },
        "speed": {
          "type": "float"
        },
        "heading": {
          "type": "float"
        },
        "movement": {
          "properties": {
            "distance_from_prev": {
              "type": "float"
            },
            "time_from_prev": {
              "type": "integer"
            },
            "avg_speed": {
              "type": "float"
            },
            "direction": {
              "type": "keyword",
              "ignore_above": 256
            },
            "path": {
              "type": "geo_shape"
            }
          }
        },
        "parking_lot": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "code": {
              "type": "keyword",
              "ignore_above": 256
            },
            "entrance": {
              "type": "geo_point"
            },
            "exit": {
              "type": "geo_point"
            },
            "capacity": {
              "type": "integer"
            },
            "occupancy": {
              "type": "integer"
            }
          }
        },
        "poi": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "distance": {
              "type": "float"
            },
            "bearing": {
              "type": "float"
            }
          }
        },
        "route": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "waypoints": {
              "type": "geo_point"
            },
            "distance": {
              "type": "float"
            },
            "estimated_time": {
              "type": "integer"
            }
          }
        },
        "weather": {
          "properties": {
            "temperature": {
              "type": "float"
            },
            "conditions": {
              "type": "keyword",
              "ignore_above": 256
            },
            "wind_speed": {
              "type": "float"
            },
            "wind_direction": {
              "type": "float"
            },
            "precipitation": {
              "type": "float"
            },
            "visibility": {
              "type": "float"
            }
          }
        },
        "metadata": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "composed_of": ["component_base_settings", "component_base_mappings"],
  "priority": 100,
  "version": 1,
  "_meta": {
    "description": "Index template for geolocation data",
    "managed_by": "parking-management-system",
    "version": "1.0.0"
  }
}