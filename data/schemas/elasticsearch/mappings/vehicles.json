{
  "index_patterns": ["vehicles-*", "vehicle-records-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "max_result_window": 10000,
        "mapping": {
          "total_fields": {
            "limit": 500
          }
        },
        "analysis": {
          "analyzer": {
            "license_plate_analyzer": {
              "type": "custom",
              "tokenizer": "keyword",
              "filter": ["lowercase", "trim", "license_plate_pattern"]
            },
            "license_plate_partial_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim"]
            },
            "vehicle_make_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim", "asciifolding"]
            },
            "vehicle_model_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim", "asciifolding"]
            },
            "vehicle_color_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim"]
            },
            "phonetic_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "phonetic"]
            }
          },
          "filter": {
            "license_plate_pattern": {
              "type": "pattern_replace",
              "pattern": "[^A-Za-z0-9]",
              "replacement": ""
            },
            "phonetic": {
              "type": "phonetic",
              "encoder": "metaphone",
              "replace": false
            }
          },
          "normalizer": {
            "license_plate_normalizer": {
              "type": "custom",
              "filter": ["lowercase", "asciifolding", "trim"]
            },
            "vehicle_make_normalizer": {
              "type": "custom",
              "filter": ["lowercase", "asciifolding", "trim"]
            }
          }
        }
      }
    },
    "mappings": {
      "_source": {
        "enabled": true
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256,
                  "normalizer": "license_plate_normalizer"
                }
              }
            }
          }
        },
        {
          "vehicle_identifiers": {
            "match": "*_id|*_number|*_code",
            "match_pattern": "regex",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "vehicle_attributes": {
            "match": "is_*|has_*",
            "match_pattern": "regex",
            "mapping": {
              "type": "boolean"
            }
          }
        },
        {
          "vehicle_measurements": {
            "match": "*_meters|*_kg|*_cm|height|length|width|weight",
            "match_pattern": "regex",
            "mapping": {
              "type": "float"
            }
          }
        },
        {
          "vehicle_dates": {
            "match": "*_date|*_at|*_expiry",
            "match_pattern": "regex",
            "mapping": {
              "type": "date"
            }
          }
        },
        {
          "vehicle_counts": {
            "match": "*_count",
            "match_pattern": "regex",
            "mapping": {
              "type": "integer"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "vehicle_id": {
          "type": "keyword",
          "ignore_above": 100
        },
        "vehicle_uuid": {
