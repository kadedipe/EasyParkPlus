          "ignore_above": 100
        },
        "license_plate": {
          "type": "text",
          "analyzer": "license_plate_analyzer",
          "fields": {
            "keyword": {
              "type": "keyword",
              "normalizer": "license_plate_normalizer"
            },
            "partial": {
              "type": "text",
              "analyzer": "license_plate_partial_analyzer"
            },
            "phonetic": {
              "type": "text",
              "analyzer": "phonetic_analyzer"
            },
            "raw": {
              "type": "keyword",
              "ignore_above": 50
            }
          }
        },
        "license_plate_normalized": {
          "type": "keyword",
