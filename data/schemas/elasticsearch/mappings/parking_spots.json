              "type": "boolean"
            },
            "is_visitor": {
              "type": "boolean"
            },
            "is_monthly": {
              "type": "boolean"
            },
            "is_ev_charging": {
              "type": "boolean"
            },
            "has_cctv": {
              "type": "boolean"
            },
            "has_sensor": {
              "type": "boolean"
            },
            "has_lighting": {
              "type": "boolean"
            },
