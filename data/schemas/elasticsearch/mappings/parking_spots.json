{
  "index_patterns": ["parking-spots-*", "parking-spaces-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "max_result_window": 10000,
        "mapping": {
          "total_fields": {
            "limit": 500
          }
        },
        "analysis": {
          "analyzer": {
            "spot_location_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim"]
            },
            "spot_number_analyzer": {
              "type": "custom",
              "tokenizer": "keyword",
              "filter": ["lowercase", "trim"]
            },
            "spot_type_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "trim"]
            }
          },
          "normalizer": {
            "spot_normalizer": {
              "type": "custom",
              "filter": ["lowercase", "asciifolding"]
            }
          }
        }
      }
    },
    "mappings": {
      "_source": {
        "enabled": true
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        {
          "spot_attributes": {
            "match": "attr_*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "spot_metrics": {
            "match": "*_count|*_rate|*_percentage",
            "mapping": {
              "type": "float"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "spot_id": {
          "type": "keyword",
          "ignore_above": 100
        },
        "spot_number": {
          "type": "keyword",
          "ignore_above": 50,
          "fields": {
            "text": {
              "type": "text",
              "analyzer": "spot_number_analyzer"
            }
          }
        },
        "display_name": {
          "type": "text",
          "analyzer": "standard",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "barcode": {
          "type": "keyword",
          "ignore_above": 100
        },
        "qr_code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "rfid_tag": {
          "type": "keyword",
          "ignore_above": 100
        },
        "status": {
          "type": "keyword",
          "ignore_above": 50
        },
        "previous_status": {
          "type": "keyword",
          "ignore_above": 50
        },
        "status_changed_at": {
          "type": "date"
        },
        "status_duration_seconds": {
          "type": "integer"
        },
        "spot_type": {
          "type": "keyword",
          "ignore_above": 50,
          "fields": {
            "text": {
              "type": "text",
              "analyzer": "spot_type_analyzer"
            }
          }
        },
        "spot_category": {
          "type": "keyword",
          "ignore_above": 50
        },
        "size_category": {
          "type": "keyword",
          "ignore_above": 20
        },
        "level": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 100
            },
            "number": {
              "type": "integer"
            },
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "code": {
              "type": "keyword",
              "ignore_above": 50
            },
            "section": {
              "type": "keyword",
              "ignore_above": 50
            },
            "zone": {
              "type": "keyword",
              "ignore_above": 50
            },
            "floor": {
              "type": "integer"
            },
            "total_spaces": {
              "type": "integer"
            },
            "available_spaces": {
              "type": "integer"
            }
          }
        },
        "location": {
          "properties": {
            "lot_id": {
              "type": "keyword",
              "ignore_above": 100
            },
            "lot_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "lot_code": {
              "type": "keyword",
              "ignore_above": 50
            },
            "address": {
              "type": "text",
              "analyzer": "spot_location_analyzer"
            },
            "city": {
              "type": "keyword",
              "ignore_above": 100
            },
            "state": {
              "type": "keyword",
              "ignore_above": 100
            },
            "country": {
              "type": "keyword",
