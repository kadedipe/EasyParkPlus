            },
            "coordinates": {
              "type": "geo_point"
            },
            "bounding_box": {
              "type": "geo_shape"
            },
            "entrance_distance_meters": {
              "type": "float"
            },
            "elevator_distance_meters": {
              "type": "float"
            },
            "stair_distance_meters": {
              "type": "float"
            },
            "nearest_landmark": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        "dimensions": {
          "properties": {
            "width_meters": {
              "type": "float"
            },
            "length_meters": {
              "type": "float"
            },
            "height_meters": {
              "type": "float"
            },
            "area_sq_meters": {
              "type": "float"
            },
            "angle_degrees": {
              "type": "float"
            },
            "is_angled": {
              "type": "boolean"
            },
            "is_parallel": {
              "type": "boolean"
            },
            "is_compact": {
              "type": "boolean"
            }
          }
        },
        "attributes": {
          "properties": {
            "is_handicapped": {
