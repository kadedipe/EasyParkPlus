{
  "available_spots_by_location": {
    "description": "Find available parking spots near a location",
    "query": {
      "bool": {
        "must": [
          {
            "term": {
              "status": "available"
            }
          }
        ],
        "filter": [
          {
            "geo_distance": {
              "distance": "{{radius}}",
              "location.coordinates": {
                "lat": "{{lat}}",
                "lon": "{{lon}}"
              }
            }
          }
        ]
      }
    },
    "sort": [
      {
        "_geo_distance": {
          "location.coordinates": {
            "lat": "{{lat}}",
            "lon": "{{lon}}"
          },
          "order": "asc",
          "unit": "m"
        }
      }
    ]
  },
  "available_spots_by_type": {
    "description": "Find available spots by type and attributes",
    "query": {
      "bool": {
        "must": [
          {
            "term": {
              "status": "available"
            }
          },
          {
            "term": {
              "spot_type": "{{spot_type}}"
            }
          }
        ],
        "filter": [
          {
            "terms": {
              "attributes": "{{attributes}}"
            }
          }
        ]
      }
    },
    "aggs": {
      "by_level": {
        "terms": {
          "field": "level.number",
          "size": 10
        }
      },
      "by_section": {
        "terms": {
          "field": "level.section",
          "size": 10
        }
      }
    }
  },
  "spot_occupancy_stats": {
    "description": "Get occupancy statistics for a spot",
    "query": {
      "bool": {
        "must": [
          {
            "term": {
              "spot_id": "{{spot_id}}"
            }
          }
        ]
      }
    },
    "aggs": {
      "occupancy_over_time": {
        "date_histogram": {
          "field": "occupancy.last_occupancy_change",
          "fixed_interval": "{{interval}}"
        },
        "aggs": {
          "avg_occupancy": {
            "avg": {
              "field": "occupancy.occupancy_percentage"
            }
          }