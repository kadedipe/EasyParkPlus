{
  "template": {
    "mappings": {
      "_source": {
        "enabled": true,
        "excludes": [
          "maintenance.maintenance_history.description"
        ]
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        {
          "spot_identifiers": {
            "match": "*_id|*_code|*_tag",
            "match_pattern": "regex",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "spot_attributes": {
            "match": "is_*",
            "match_pattern": "regex",
            "mapping": {
              "type": "boolean"
            }
          }
        },
        {
          "spot_measurements": {
            "match": "*_meters|*_kw|*_kwh|*_sq_meters",
            "match_pattern": "regex",
            "mapping": {
              "type": "float"
            }
          }
        },
        {
          "spot_counts": {
            "match": "*_count",
            "match_pattern": "regex",
            "mapping": {
              "type": "integer"
            }
          }
        },
        {
          "spot_rates": {
            "match": "*_rate",
            "match_pattern": "regex",
            "mapping": {
              "type": "float"
            }
          }
        },
        {
          "geo_points": {
            "match": "coordinates|location",
            "mapping": {
              "type": "geo_point"
            }
          }
        },
        {
          "geo_shapes": {
            "match": "*_area|*_box",
            "mapping": {
              "type": "geo_shape"
            }
          }
        },
        {
          "timestamps": {
            "match": "*_at",
            "match_pattern": "regex",
            "mapping": {
              "type": "date"
            }
          }
        }
      ]
    }
  },
  "version": 1,
  "_meta": {
    "description": "Mappings component template for parking spots",
    "managed_by": "parking-management-system"
  }
}