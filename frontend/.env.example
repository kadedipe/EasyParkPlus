# ============================================
# PARKING MANAGEMENT SYSTEM - FRONTEND
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# Copy this file to .env.local and update with your values
# Never commit .env files to version control!
# ============================================

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Application environment (development/staging/production)
VITE_APP_ENV=development

# Application name
VITE_APP_NAME="Parking Management System"

# Application version (auto-filled from package.json)
VITE_APP_VERSION=1.0.0

# Application URL
VITE_APP_URL=http://localhost:3000

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL (required)
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket URL (optional, defaults to API URL with ws protocol)
VITE_WS_URL=ws://localhost:8000/ws

# API timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# Number of retry attempts for failed requests (default: 3)
VITE_API_RETRY_COUNT=3

# ============================================
# AUTHENTICATION
# ============================================
# JWT token storage key (default: parking_auth_token)
VITE_JWT_STORAGE_KEY=parking_auth_token

# Session timeout in milliseconds (default: 3600000 - 1 hour)
VITE_SESSION_TIMEOUT=3600000

# Maximum login attempts before lockout (default: 5)
VITE_MAX_LOGIN_ATTEMPTS=5

# ============================================
# GOOGLE MAPS
# ============================================
# Google Maps API Key (required for maps functionality)
# Get it from: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Google Maps libraries to load (comma-separated)
VITE_GOOGLE_MAPS_LIBRARIES=places,geometry,drawing

# Default map center coordinates (New York City as example)
VITE_DEFAULT_MAP_CENTER_LAT=40.7128
VITE_DEFAULT_MAP_CENTER_LNG=-74.0060

# Default map zoom level (default: 12)
VITE_DEFAULT_MAP_ZOOM=12

# ============================================
# PAYMENT GATEWAYS
# ============================================
# Stripe Public Key (required for payments)
# Get test key from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# PayPal Client ID (optional)
# Get from: https://developer.paypal.com/developer/applications
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# ============================================
# FIREBASE CONFIGURATION (Optional)
# ============================================
# Used for authentication and push notifications
# Get from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features (default: false)
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_MULTI_FACTOR_AUTH=true
VITE_ENABLE_WAITLIST=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================
# Google Analytics Tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/your-project

# LogRocket App ID
VITE_LOGROCKET_APP_ID=your-logrocket-app-id

# Mixpanel Token
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# Hotjar ID
VITE_HOTJAR_ID=123456

# ============================================
# UI/UX DEFAULTS
# ============================================
# Default theme (light/dark)
VITE_DEFAULT_THEME=light

# Default language (en/es/fr/de/zh/ja)
VITE_DEFAULT_LANGUAGE=en

# Date format (MM/DD/YYYY, DD/MM/YYYY, YYYY-MM-DD)
VITE_DATE_FORMAT=MM/DD/YYYY

# Time format (12h or 24h)
VITE_TIME_FORMAT=hh:mm A

# Currency settings
VITE_CURRENCY=USD
VITE_CURRENCY_SYMB=$

# Distance unit (miles or km)
VITE_DISTANCE_UNIT=miles

# Pagination
VITE_DEFAULT_PAGE_SIZE=20

# ============================================
# DEVELOPMENT SERVER
# ============================================
# Vite dev server port (default: 3000)
VITE_DEV_SERVER_PORT=3000

# Open browser automatically (default: true)
VITE_DEV_SERVER_OPEN=true

# Enable HTTPS for dev server (default: false)
VITE_DEV_SERVER_HTTPS=false

# Hot Module Replacement (default: true)
VITE_HMR_ENABLED=true

# Proxy API requests to backend (default: true)
VITE_PROXY_API=/api
VITE_PROXY_TARGET=http://localhost:8000

# ============================================
# TESTING
# ============================================
# Test user credentials (for development only)
VITE_TEST_USER_EMAIL=test@example.com
VITE_TEST_USER_PASSWORD=Test123!

# Admin test credentials
VITE_TEST_ADMIN_EMAIL=admin@example.com
VITE_TEST_ADMIN_PASSWORD=Admin123!

# Enable Mock Service Worker for API mocking (default: false)
VITE_MSW_ENABLED=false

# ============================================
# PWA CONFIGURATION
# ============================================
# PWA manifest settings
VITE_PWA_NAME="Parking Management"
VITE_PWA_SHORT_NAME="Parking"
VITE_PWA_THEME_COLOR=#1976d2
VITE_PWA_BACKGROUND_COLOR=#ffffff

# Service worker (default: true)
VITE_SERVICE_WORKER_ENABLED=true

# ============================================
# EXTERNAL SERVICES
# ============================================
# reCAPTCHA Site Key (for form protection)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Algolia Search (optional)
VITE_ALGOLIA_APP_ID=your-algolia-app-id
VITE_ALGOLIA_SEARCH_KEY=your-algolia-search-key
VITE_ALGOLIA_INDEX_NAME=parking_spots

# Mapbox (alternative to Google Maps)
VITE_MAPBOX_TOKEN=your-mapbox-token

# Intercom (customer support)
VITE_INTERCOM_APP_ID=your-intercom-app-id

# ============================================
# CONTACT INFORMATION
# ============================================
VITE_CONTACT_EMAIL=support@parking.example.com
VITE_CONTACT_PHONE=+1-800-PARKING
VITE_CONTACT_TWITTER=@parkingapp
VITE_CONTACT_FACEBOOK=parkingapp
VITE_CONTACT_INSTAGRAM=parkingapp

# ============================================
# LEGAL LINKS
# ============================================
VITE_LEGAL_TERMS_URL=https://parking.example.com/terms
VITE_LEGAL_PRIVACY_URL=https://parking.example.com/privacy
VITE_LEGAL_COOKIES_URL=https://parking.example.com/cookies

# ============================================
# BRANDING
# ============================================
VITE_LOGO_URL=/logo.svg
VITE_FAVICON_URL=/favicon.ico
VITE_OG_IMAGE_URL=/og-image.jpg

# ============================================
# DEBUG SETTINGS
# ============================================
# Enable debug mode (default: false in production)
VITE_DEBUG_MODE=false
VITE_DEBUG_REDUX=false
VITE_DEBUG_QUERY=false
VITE_DEBUG_WEBSOCKET=false

# ============================================
# CACHE CONFIGURATION
# ============================================
# Cache TTL in milliseconds (default: 300000 - 5 minutes)
VITE_CACHE_TTL=300000

# ============================================
# FILE UPLOAD
# ============================================
# Maximum upload size in bytes (default: 5242880 - 5MB)
VITE_MAX_UPLOAD_SIZE=5242880

# ============================================
# NOTES
# ============================================
# 1. All variables must start with VITE_ to be exposed to the client
# 2. Never commit real API keys or secrets to version control
# 3. Use different API keys for development and production
# 4. Google Maps API key requires billing enabled (but has free tier)
# 5. Stripe test keys start with pk_test_ (never use live keys in development)
# ============================================