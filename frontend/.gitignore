!*.example.ts
!*.example.json
!*.example.yml
!*.example.yaml
!*.example.config.js
!*.sample.js
!*.sample.ts
!*.sample.json
!*.sample.yml
!*.sample.yaml

# Keep required empty directories
!.gitkeep
!.keep

# Keep public assets
!public/
!public/index.html
!public/favicon.ico
!public/logo.svg
!public/manifest.json
!public/robots.txt

# Keep source files
