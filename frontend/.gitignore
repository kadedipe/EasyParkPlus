# ============================================
# Security Notes
# ============================================
# Never commit:
# - Environment files with real credentials
# - API keys
# - Database passwords
# - JWT secrets
# - SSH keys
# - SSL certificates
# - Service account files
# - Any file containing secrets

# ============================================
# Conditional Ignores
# ============================================

# Ignore compiled files but not source
*.js.map
*.js
!src/**/*.js
!scripts/*.js
!vite.config.js
!*.config.js

# Ignore CSS files but not source
*.css
*.css.map
!src/**/*.css

# Ignore test snapshots but not test files
__snapshots__/
**/__snapshots__/
*.snap
!tests/**/*.snap

