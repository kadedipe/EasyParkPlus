# ============================================
# Exception Rules (Files to keep)
# ============================================

# Keep example environment files
!.env.example
!.env.dist
!.env.sample
!.env.template

# Keep sample data
!sample_data/
!example_data/
!demo_data/

# Keep example configurations
!config.example.*
!*.example
!*.sample
!*.template
!*.dist

# Keep public assets
!public/
!public/**/*
!assets/
!assets/**/*

# Keep required empty directories
!.gitkeep
!.keep

# Keep documentation images
!docs/images/
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg
!docs/**/*.gif

# Keep license and readme
!LICENSE*
!README*
!CONTRIBUTING*
!CODE_OF_CONDUCT*
!CHANGELOG*

# Keep build configuration
!Dockerfile
!docker-compose*.yml
!.dockerignore
!.gitignore
!.gitattributes
!.editorconfig
!.prettierrc
!.eslintrc
!.stylelintrc
!.browserslistrc

# Keep sample data
!tests/fixtures/
!tests/fixtures/**/*
!tests/data/
!tests/data/**/*
!seeds/
!seeds/**/*
!fixtures/
!fixtures/**/*

# ============================================
# Conditional Ignores
# ============================================

# Ignore compiled files but not source
*.pyc
__pycache__/
!*.py

# Ignore built files but not source
dist/
build/
!src/
!lib/

# Ignore test coverage but not tests
coverage/
htmlcov/
!tests/

# Ignore environment but keep example
.env
.env.*
!.env.example
!.env.dist

# Ignore logs but keep log directories
logs/
*.log
!logs/.gitkeep

# Ignore uploads but keep directory structure
uploads/
media/
static/
!uploads/.gitkeep
!media/.gitkeep
!static/.gitkeep