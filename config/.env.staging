# Staging Environment
PARKING_ENV=staging
SECRET_KEY=staging-secret-key-change-in-production
JWT_SECRET_KEY=staging-secret-key-change-in-production

# Database
DB_HOST=staging-db.example.com
DB_PORT=5432
DB_NAME=parking_staging
DB_USER=parking_app
DB_PASSWORD=staging-db-password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_HOST=staging-redis.example.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=staging-redis-password
REDIS_SSL=true

# Elasticsearch
ELASTICSEARCH_HOSTS=staging-es1:9200,staging-es2:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=staging-es-password
ELASTICSEARCH_VERIFY_CERTS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30

# CORS
CORS_ALLOW_ORIGINS=https://staging.parking.com,https://admin.staging.parking.com

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=staging@parking.com
MAIL_PASSWORD=staging-email-password
MAIL_DEFAULT_SENDER=noreply@staging.parking.com

# SMS
TWILIO_ACCOUNT_SID=staging-twilio-sid
TWILIO_AUTH_TOKEN=staging-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment (Test keys)
STRIPE_API_KEY=sk_test_staging_key
STRIPE_WEBHOOK_SECRET=whsec_staging_secret
PAYPAL_CLIENT_ID=staging_paypal_client_id
PAYPAL_CLIENT_SECRET=staging_paypal_secret
PAYPAL_MODE=sandbox

# Monitoring
SENTRY_DSN=https://staging-key@sentry.io/123
SENTRY_TRACES_SAMPLE_RATE=0.5
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090