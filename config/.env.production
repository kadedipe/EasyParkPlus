# Production Environment
PARKING_ENV=production
SECRET_KEY=production-secret-key-very-long-and-secure
JWT_SECRET_KEY=production-jwt-secret-key-very-long-and-secure

# Database
DB_HOST=production-db.cluster-xxx.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=parking_prod
DB_USER=parking_app
DB_PASSWORD=production-db-password-very-secure
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20

# Redis
REDIS_HOST=production-redis.xxx.ng.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=production-redis-password
REDIS_SSL=true

# Elasticsearch
ELASTICSEARCH_HOSTS=production-es1:9200,production-es2:9200,production-es3:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=production-es-password
ELASTICSEARCH_VERIFY_CERTS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=8
API_TIMEOUT=30

# CORS
CORS_ALLOW_ORIGINS=https://parking.com,https://admin.parking.com,https://api.parking.com

# Email
MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=AKIAXXXXXXXXXXXX
MAIL_PASSWORD=production-email-password
MAIL_DEFAULT_SENDER=noreply@parking.com

# SMS
TWILIO_ACCOUNT_SID=production-twilio-sid
TWILIO_AUTH_TOKEN=production-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment (Live keys)
STRIPE_API_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
PAYPAL_CLIENT_ID=production_paypal_client_id
PAYPAL_CLIENT_SECRET=production_paypal_secret
PAYPAL_MODE=live

# Monitoring
SENTRY_DSN=https://production-key@sentry.io/123
SENTRY_TRACES_SAMPLE_RATE=0.1
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Storage (AWS S3)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=production-aws-secret-key
AWS_S3_BUCKET=parking-prod-uploads
AWS_REGION=us-east-1
CDN_URL=https://d123.cloudfront.net