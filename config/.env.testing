# Testing Environment
PARKING_ENV=testing
SECRET_KEY=test-secret-key
JWT_SECRET_KEY=test-secret-key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parking_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# API
API_HOST=127.0.0.1
API_PORT=8001
API_WORKERS=1
API_TIMEOUT=5

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# Email (Dummy)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_DEFAULT_SENDER=test@parking.test

# Payment (Mock)
STRIPE_API_KEY=sk_test_mock
PAYPAL_CLIENT_ID=mock_client_id
PAYPAL_CLIENT_SECRET=mock_client_secret

# Monitoring
SENTRY_ENABLED=false
PROMETHEUS_ENABLED=false